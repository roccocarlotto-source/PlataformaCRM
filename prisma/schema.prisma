generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum LifecycleStage {
  LEAD
  MQL
  SQL
  CUSTOMER
  CHURNED
}

// Urgencia de un lead (Contact.leadUrgency). Enum y no texto libre, a
// diferencia de leadIntent/leadServiceOfInterest: la urgencia es un concepto
// acotado que cruza todos los verticales del negocio (una automotora y una
// clínica la miden igual), mientras que la intención varía demasiado entre
// rubros para un catálogo cerrado.
enum LeadUrgency {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// PENDING -> ACCEPTED (el invitado completó el flujo) | REVOKED (un ADMIN la
// canceló) | EXPIRED (pasó expiresAt sin aceptarse). La transición a EXPIRED
// es perezosa: no hay job programado, se recalcula en el momento en que
// importa (crear una nueva invitación para el mismo email, listar, aceptar)
// — ver invitation.repository.ts (expireDueInvitations).
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Tipo de integración de una Source. WEBHOOK: la fuente empuja un payload por
// HTTP (formulario de landing page). FILE_IMPORT: se sube un Excel/CSV.
// EXTERNAL_DB: se lee de una base de datos ajena — pospuesto a propósito, ver
// la sección 7 de docs/ingestion-architecture.md.
enum SourceType {
  WEBHOOK
  FILE_IMPORT
  EXTERNAL_DB
}

// Ciclo de vida de un IngestionEvent. PENDING (recién aterrizado, esperando al
// worker) -> PROCESSED (promovido a Contact) | FAILED (la fila no era válida;
// errorMessage dice por qué, y el resto del lote siguió) | DUPLICATE (ya había
// sido ingerido antes) | DEAD_LETTER (agotó sus reintentos contra un error de
// SISTEMA — B-30 de docs/auditoria-2026-08-29.md).
//
// FAILED y DEAD_LETTER son terminales los dos, pero dicen cosas distintas —la
// misma distinción que el comentario de OutboxStatus, del otro lado: FAILED es
// "este payload nunca va a servir" (dato inválido, terminal desde el primer
// fallo, sin gastar reintentos); DEAD_LETTER es "esto SÍ podría haber servido,
// pero un error de sistema se repitió hasta agotar attempts". Colapsarlos
// haría indistinguible un dato malo de un bug nuestro.
enum IngestionStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
  DEAD_LETTER
}

// Ciclo de vida de un OutboxEvent. PENDING (esperando entrega o su próximo
// reintento) -> PROCESSED (el handler entregó) | DEAD_LETTER (agotó los
// intentos, o no hay handler para su eventType).
//
// NO HAY FAILED TRANSITORIO, a diferencia de IngestionStatus, y es una
// diferencia deliberada: allá FAILED significa "esta fila nunca va a servir"
// (el payload no era válido) y es terminal. Acá un fallo de entrega es, por
// defecto, TRANSITORIO — el destino externo puede estar caído— así que el
// evento se queda en PENDING con nextAttemptAt en el futuro. Un estado
// intermedio solo agregaría un valor más que todo consumidor tiene que
// entender, sin distinguir nada que attempts y nextAttemptAt no digan ya.
enum OutboxStatus {
  PENDING
  PROCESSED
  DEAD_LETTER
}

// Tipo de recurso agendable (docs/booking-architecture.md §3). PERSON: una
// persona que atiende (un barbero, un médico). ROOM: un espacio (una sala, una
// cancha). CLASS: una clase con cupo, donde el recurso no es ni una persona ni
// un lugar sino la clase misma.
enum ResourceType {
  PERSON
  ROOM
  CLASS
}

// Ciclo de vida de la conexión OAuth de una sucursal con Google Calendar
// (docs/booking-architecture.md §4). ACTIVE: hay un refresh token válido y
// utilizable. REVOKED: la desconectó un ADMIN desde el CRM — es un estado
// deliberado, no una falla. ERROR: Google rechazó el token (el usuario revocó el
// acceso desde su propia cuenta, o el grant caducó) — es una falla que necesita
// que alguien reconecte, y el motivo queda en lastErrorMessage.
//
// REVOKED y ERROR son el MISMO estado operativo —no se puede llamar a Google— y
// aun así son dos valores distintos a propósito: solo ERROR es una anomalía que
// alguien tiene que mirar. Colapsarlos haría imposible distinguir "esta sucursal
// decidió no usar Google" de "esta sucursal se rompió y nadie se enteró".
enum ConnectionStatus {
  ACTIVE
  REVOKED
  ERROR
}

// Día de la semana de una franja de horario de trabajo (WorkingHours).
//
// ENUM Y NO UN ENTERO 0-6, y es la decisión que evita el bug clásico de esta
// clase de modelo: no hay una convención universal sobre si 0 es domingo o
// lunes — `Date.getDay()` dice domingo, ISO-8601 y Luxon dicen lunes— así que un
// entero obliga a que TODO consumidor recuerde cuál se eligió, y el día que uno
// se equivoque el horario queda corrido un día sin ningún error visible.
//
// El orden de los valores es el ISO (lunes primero), y el mapeo desde el número
// de Luxon vive en un solo lugar: src/utils/workingHours.ts.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Ciclo de vida de un Booking (docs/booking-architecture.md §3).
//
// CONFIRMED es el único estado que OCUPA CUPO. Los otros tres son historia:
// CANCELLED (se dio de baja, el cupo se liberó), COMPLETED (la persona vino) y
// NO_SHOW (no vino). Ninguno de esos tres bloquea una reserva nueva en el mismo
// horario ni impide borrar el servicio — ver contarReservasActivas() en
// serviceType.service.ts y contarReservasSuperpuestas() en booking.repository.ts,
// que son los dos lugares donde esa distinción decide algo.
enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ---------------------------------------------------------------------------
// ConversationChannel / ConversationStatus / MessageDirection /
// MessageSenderType — módulo de Agentes de IA (docs/ai-agent-architecture.md
// §3). Cuatro enums cerrados a propósito: el catálogo de canales y de estados
// lo define el producto, no cada negocio. Lo que SÍ cambia más rápido que un
// catálogo (proveedor y nombre del modelo de LLM) es String en Agent, no enum —
// mismo criterio que Opportunity.currency.
// ---------------------------------------------------------------------------

// En qué canal ocurre una conversación. Un Agent declara en `channels` en
// cuáles puede operar; una Conversation nace en uno solo.
enum ConversationChannel {
  WHATSAPP
  WEB
}

// Ciclo de vida de una Conversation. Es la fuente de verdad (no hay
// deletedAt): TRANSFERRED_TO_HUMAN es el handoff de §6 y CLOSED es el cierre —
// una conversación cerrada es historia que se conserva, no se borra.
enum ConversationStatus {
  ACTIVE
  TRANSFERRED_TO_HUMAN
  CLOSED
}

// INBOUND: llegó del contacto. OUTBOUND: salió del negocio (el agente de IA o
// una persona). Es ortogonal a senderType a propósito: la dirección dice por
// dónde viajó el mensaje, el tipo de emisor dice quién lo escribió.
enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Quién escribió un Message. HUMAN exige senderUserId y CONTACT/AGENT exigen
// que esté en NULL — lo sostiene el CHECK
// messages_sender_user_id_consistency_check de la migración 20260912130000.
enum MessageSenderType {
  CONTACT
  AGENT
  HUMAN
}

// ---------------------------------------------------------------------------
// QrType / QrSubscriptionStatus / QrSubscriptionChangeSource — módulo QR
// (integración de QR Reviews, ver docs/qr-integration.md). Portados 1:1 de
// los enums `subscription_status` / `subscription_change_source` del proyecto
// Supabase original de QR Reviews (Plataforma-QR/supabase/migrations/0001_init.sql).
//
// QrType (REUSABLE/SINGLE_USE, de 0015_single_use_qr.sql) EXISTIÓ acá y se
// eliminó en 20260904120000_remove_qr_claim_and_single_use: Rocco descartó el
// QR físico/de un solo uso a favor de mandar el link directo por CRM (ver
// docs/qr-integration.md, sección "Qué se desvió"). No lo reintroduzcas sin
// leer esa sección primero.
// ---------------------------------------------------------------------------

enum QrSubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum QrSubscriptionChangeSource {
  MERCADOPAGO_WEBHOOK
  PLATFORM_ADMIN
}

// ---------------------------------------------------------------------------
// Enums del módulo de stock de vehículos (Fase 1: solo esquema). Los modelos
// están al final del archivo, en la sección "Módulo de stock de vehículos".
//
// CRITERIO PARA DECIDIR ENUM vs. TEXTO LIBRE, aplicado campo por campo: es enum
// lo que tiene un dominio cerrado y estable que además se FILTRA (condición,
// estado, combustible, caja); es VarChar lo que cambia con cada fabricante y
// cada año (exteriorColor, upholstery, trim) — un enum ahí obligaría a una
// migración por cada color nuevo de catálogo.
//
// NINGUNO DE ESTOS ENUMS LLEVA VALOR "UNKNOWN"/"OTHER": la ficha tiene modo
// borrador y la columna es nullable, así que "todavía no se cargó" es NULL, no
// un valor más que después haya que filtrar en cada consulta.
// ---------------------------------------------------------------------------

// 0 km o usado. Obligatorio incluso en borrador: es el primer filtro del
// listado y decide qué campos tienen sentido (mileage, singleOwner, etc.).
enum VehicleCondition {
  NEW
  USED
}

enum VehicleBodyType {
  SEDAN
  HATCHBACK
  SUV
  PICKUP
  COUPE
  WAGON
  VAN
  UTILITY
  MINIVAN
}

// Ciclo de vida comercial de la unidad. NO es un flujo lineal: una unidad va
// y vuelve entre AVAILABLE/RESERVED/IN_PREPARATION según lo que pase con la
// venta; SOLD es el único terminal en la práctica. Independiente de
// visibleInListing y de publishOnWebsite: una unidad SOLD puede seguir
// publicada como "vendida" y una AVAILABLE puede estar oculta.
enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_PREPARATION
  IN_TRANSIT
  SOLD
}

// Cómo entró la unidad al stock. CONSIGNMENT es el único valor con campos
// propios (consignor* / consignment* en Vehicle) y el CHECK de la migración
// solo los admite con este origen.
enum VehicleOrigin {
  DIRECT_PURCHASE
  TRADE_IN
  CONSIGNMENT
  IMPORT
  BRANCH_TRANSFER
}

// En qué moneda se muestra el precio al público. BOTH es el default porque en
// el mercado de origen (Argentina) el usado se cotiza en USD y se paga en
// pesos: mostrar los dos es lo normal, no la excepción. Se guardan LOS DOS
// precios (priceListUsd / priceListLocal) y esto solo decide cuál se exhibe.
enum VehiclePublicationCurrency {
  BOTH
  USD_ONLY
  LOCAL_ONLY
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
  AUTOMATIC_SEQUENTIAL
  CVT
}

// GASOLINE_CNG es aparte de CNG a propósito: un auto con equipo de GNC sigue
// siendo naftero y se busca como tal; uno CNG "puro" (de fábrica) es otra cosa
// para el comprador y para la documentación.
enum VehicleFuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  CNG
  GASOLINE_CNG
}

// Terminación de la pintura. Es el complemento de exteriorColor (texto libre):
// el color cambia con cada catálogo, la terminación no.
enum VehicleColorFinish {
  SOLID
  METALLIC
  PEARL
  MATTE
}

// FOUR_BY_FOUR y AWD son distintos para el comprador (4x4 con reductora vs.
// tracción integral permanente) aunque los dos muevan las cuatro ruedas.
enum VehicleDrivetrain {
  FRONT
  REAR
  FOUR_BY_FOUR
  AWD
}

// Garantía que se ofrece con la unidad. DEALER_6M/DEALER_12M son las dos
// duraciones que ofrece una agencia sobre un usado; FACTORY es la del 0 km.
// OTHER (§22) es "ninguna de las anteriores": el detalle real va en
// Vehicle.warrantyOther, que solo tiene sentido con este valor.
enum VehicleWarranty {
  NONE
  FACTORY
  DEALER_6M
  DEALER_12M
  OTHER
}

// Los dos enums siguientes van en Opportunity, no en Vehicle: describen la
// VENTA (cómo se financia, por dónde llegó el interesado), no la unidad.
//
// leadSource es una ETIQUETA MANUAL que elige la persona al cargar la
// oportunidad. No tiene ninguna relación con el modelo Source de la capa de
// ingesta: aquello es una integración automatizada (webhook, importación de
// archivo) que produce IngestionEvents; esto es un dato de clasificación
// comercial que se completa a mano. Son dos conceptos distintos con nombres
// parecidos, y por eso este enum lleva el prefijo Opportunity.
enum OpportunityFinancingType {
  NONE
  INSTALLMENT_24M
  INSTALLMENT_36M
  OWN_FINANCING
}

enum OpportunityLeadSource {
  PORTAL_MERCADOLIBRE
  WEBSITE
  SHOWROOM
  REFERRAL
  WHATSAPP
}

// ---------------------------------------------------------------------------
// Organization — raíz del aislamiento multi-tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  timezone  String    @default("UTC") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ---------------------------------------------------------------------
  // Módulo QR (integración de QR Reviews) — billing a nivel Organization,
  // no por Branch (decisión del plan de integración): todas las sucursales
  // de una cuenta con el módulo activo pueden generar/gestionar QRs.
  // Prefijo "qr" deliberado: esto es el estado de la suscripción del
  // MÓDULO QR específicamente (hoy facturada aparte vía MercadoPago), no
  // necesariamente el mismo mecanismo de billing que el resto del SaaS
  // termine usando — no colisionar los dos conceptos.
  // ---------------------------------------------------------------------
  qrSubscriptionStatus        QrSubscriptionStatus @default(INACTIVE) @map("qr_subscription_status")
  qrMercadopagoSubscriptionId String?              @unique @map("qr_mercadopago_subscription_id")
  // DEC-057 original: independiente de qrSubscriptionStatus. Escribible
  // solo desde el endpoint de platform admin (Fase 2) — nunca por el propio
  // dueño de la cuenta, nunca por el webhook de MercadoPago.
  qrBillingExempt             Boolean              @default(false) @map("qr_billing_exempt")
  // DEC-064/066 original: contador durable de "próximo display_number a
  // asignar" para los QRs de esta cuenta — sobrevive borrados de QrCode
  // (nunca se reusa un número), se incrementa dentro de la misma
  // transacción con lock que el claim/create (ver Fase 2). No es una
  // sequence de Postgres a propósito: nextval() no es transaccional y
  // quemaría un número aunque la transacción que lo pidió haga rollback.
  nextQrDisplayNumber         Int                  @default(1) @map("next_qr_display_number")

  // ---------------------------------------------------------------------
  // Módulo de stock de vehículos (ver la sección al final del archivo).
  // ---------------------------------------------------------------------
  // Moneda principal y secundaria con las que la cuenta expresa sus precios
  // (códigos ISO 4217, "USD"/"ARS"/"UYU"). Nullable y sin default a
  // propósito: una organización que no usa el módulo no tiene por qué
  // declararlas, y un default "USD" haría indistinguible "eligió USD" de
  // "nunca lo configuró". VarChar(3) replica Opportunity.currency, para que
  // el mismo dato se describa de la misma forma en las dos tablas.
  preferredCurrency      String? @map("preferred_currency") @db.VarChar(3)
  alternateCurrency      String? @map("alternate_currency") @db.VarChar(3)
  // Contador durable del próximo internalCode a asignar a un Vehicle de esta
  // cuenta — réplica exacta del patrón de nextQrDisplayNumber, por las mismas
  // razones: sobrevive al soft delete de la unidad (un código nunca se
  // reusa, así que el @@unique de vehicles no necesita predicado parcial) y
  // se incrementa dentro de la misma transacción con lock que el INSERT (Fase
  // 2). No es una sequence de Postgres porque nextval() no es transaccional:
  // quemaría un número aunque la transacción que lo pidió haga rollback, y
  // el código interno de una automotora tiene que ser correlativo.
  nextVehicleStockNumber Int     @default(1) @map("next_vehicle_stock_number")

  users         User[]
  companies     Company[]
  contacts      Contact[]
  opportunities Opportunity[]
  pipelines     Pipeline[]
  stages        Stage[]
  activities    Activity[]
  invitations   Invitation[]

  sources         Source[]
  apiKeys         ApiKey[]
  ingestionEvents IngestionEvent[]
  outboxEvents    OutboxEvent[]

  branches     Branch[]
  resources    Resource[]
  serviceTypes ServiceType[]

  googleCalendarConnections GoogleCalendarConnection[]

  workingHours WorkingHours[]
  bookings     Booking[]

  agents        Agent[]
  conversations Conversation[]
  messages      Message[]

  qrCodes                     QrCode[]
  qrPaymentEvents             PaymentEvent[]
  qrSubscriptionStatusChanges QrSubscriptionStatusChange[]
  qrBillingExemptionChanges   QrBillingExemptionChange[]

  vehicles          Vehicle[]
  vehiclePhotos     VehiclePhoto[]
  vehicleChangeLogs VehicleChangeLog[]

  @@index([deletedAt])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Role — catálogo global de roles (ADMIN, USER). Sin scope por organización:
// para permisos granulares a futuro se agregan Permission/RolePermission
// sin tocar User ni Role.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  invitations Invitation[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
// User — perfil de negocio del usuario autenticado por Supabase Auth.
// id comparte valor con auth.users.id. email se sincroniza por trigger
// (ver prisma/sql/manual_constraints.sql) y nunca se escribe desde la app.
//
// isActive vs. deletedAt — semánticas distintas, no redundantes:
//   - isActive = false, deletedAt = null: usuario suspendido/desactivado,
//     reversible (PATCH puede volver a poner isActive = true).
//   - deletedAt != null: usuario removido de la organización — soft delete,
//     terminal, sin undelete en este bloque. Implica isActive = false.
// Un hard delete real está bloqueado de hecho por integridad referencial:
// Opportunity.ownerId y Activity.authorId son obligatorios y no declaran
// onDelete, así que Postgres ya rechaza borrar un User referenciado por
// cualquiera de los dos.
// ---------------------------------------------------------------------------

model User {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  ownedCompanies     Company[]     @relation("CompanyOwner")
  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities Activity[]    @relation("ActivityAuthor")
  assignedActivities Activity[]    @relation("ActivityAssignee")
  invitationsSent    Invitation[]  @relation("InvitationInvitedBy")

  // Módulo de stock de vehículos: las unidades que este vendedor tiene
  // asignadas y los cambios de ficha que registró.
  assignedVehicles Vehicle[]          @relation("VehicleAssignedSalesperson")
  vehicleChanges   VehicleChangeLog[] @relation("VehicleChangeLogChangedBy")

  // Módulo de Agentes de IA: las conversaciones que este usuario tomó tras un
  // handoff y los mensajes que escribió como HUMAN en ellas.
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageSender")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Invitation — invitación pendiente de un ADMIN a un nuevo miembro de su
// organización. status es la fuente de verdad del ciclo de vida (no
// deletedAt: acá el "removido" ya tiene nombre propio — REVOKED/EXPIRED —
// y agregar deletedAt encima obligaría a explicar en qué se diferencia de
// esos dos estados, sin buena respuesta).
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(255)
  roleId         String           @map("role_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationInvitedBy", fields: [organizationId, invitedById], references: [organizationId, id])

  // Único (organization_id, email) WHERE status = 'PENDING' — índice único
  // parcial; vive en la migración
  // 20260821140000_incorporate_manual_ddl_into_migrations (C-2), con
  // manual_constraints.sql como red de seguridad idempotente además
  // (Prisma no soporta índices únicos parciales en su DSL).
  @@index([organizationId])
  @@index([email])
  @@index([organizationId, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Company — empresa cliente/prospecto
// ---------------------------------------------------------------------------

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  name           String    @db.VarChar(255)
  domain         String?   @db.VarChar(255)
  industry       String?   @db.VarChar(100)
  phone          String?   @db.VarChar(30)
  city           String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("CompanyOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction)

  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([ownerId])
  @@index([domain])
  @@index([organizationId, name])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Contact — persona física. lifecycleStage reemplaza a la entidad Lead.
// ---------------------------------------------------------------------------

model Contact {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  companyId      String?        @map("company_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(30)
  jobTitle       String?        @map("job_title") @db.VarChar(100)
  lifecycleStage LifecycleStage @default(LEAD) @map("lifecycle_stage")
  source         String?        @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  // -------------------------------------------------------------------------
  // Calificación del lead (migración 20260912120000). Resuelve el pendiente
  // abierto el 28/08/2026 al formalizar Lead vs. Contact: los atributos que
  // el documento de visión asignaba a `Lead` viven acá, como columnas de
  // Contact y no en una tabla aparte — la relación es 1:1 y no hace falta
  // historial. TODAS nullable a propósito: un negocio que no usa calificación
  // no pierde nada. Solo schema por ahora: ningún endpoint, service ni
  // formulario las lee o escribe; quien las va a completar es el futuro
  // create_lead()/update_lead() del agente de IA (docs/roadmap-
  // implementacion.md, 2.2), directamente vía Prisma/el service, no
  // necesariamente por el endpoint HTTP de Contact. Sin índices hasta que
  // exista una consulta que filtre por alguna de ellas.
  // -------------------------------------------------------------------------
  // 0..100, información auxiliar (nunca gating). CHECK
  // contacts_lead_score_range_check en la migración: NULL o dentro del rango.
  leadScore             Int?         @map("lead_score")
  // Texto libre, sin enum: "comprar" en una automotora, "cotizar tratamiento"
  // en una clínica — la intención varía demasiado entre verticales para un
  // catálogo cerrado. Mismo criterio para leadServiceOfInterest.
  leadIntent            String?      @map("lead_intent") @db.VarChar(200)
  leadServiceOfInterest String?      @map("lead_service_of_interest") @db.VarChar(200)
  // Enum (ver LeadUrgency): concepto acotado que cruza verticales.
  leadUrgency           LeadUrgency? @map("lead_urgency")
  // Presupuesto: mismo patrón que Opportunity.amount/currency (monto + código
  // ISO 4217 de 3 letras sin enum, ~180 códigos). SIN @default en ninguno de
  // los dos, a diferencia de Opportunity: 0 no es "sin presupuesto", es
  // "presupuesto cero", y son cosas distintas. CHECK
  // contacts_lead_budget_amount_non_negative_check en la migración: NULL o
  // >= 0.
  leadBudgetAmount      Decimal?     @map("lead_budget_amount") @db.Decimal(14, 2)
  leadBudgetCurrency    String?      @map("lead_budget_currency") @db.VarChar(3)
  // Zona / ciudad, texto libre.
  leadLocation          String?      @map("lead_location") @db.VarChar(200)
  // Texto libre sin límite corto (@db.Text y no VarChar) porque está pensado
  // para que un futuro update_lead() del agente AGREGUE contenido (concatene)
  // en vez de sobreescribir: así no se pierden los matices o ambigüedades que
  // el agente fue registrando en distintas conversaciones. Ese "agregar, no
  // pisar" es responsabilidad de la capa de servicio que todavía no existe;
  // acá solo se dimensiona la columna.
  leadNotes             String?      @map("lead_notes") @db.Text
  // Cualquier dato que el agente extraiga de la conversación y no tenga
  // columna propia.
  leadAiData            Json?        @map("lead_ai_data")
  // Campos personalizados por industria ("tratamiento" en una clínica,
  // "dormitorios" en una inmobiliaria — principio rector 13 del documento de
  // visión). Sin catálogo formal de definiciones todavía: eso sería una tabla
  // CustomFieldDefinition por organización (tipo/opciones/validación) y se
  // formaliza cuando un segundo vertical real lo necesite, no antes.
  customFields          Json?        @map("custom_fields")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  owner        User?        @relation("ContactOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction)

  opportunities   Opportunity[]
  activities      Activity[]
  ingestionEvents IngestionEvent[]
  bookings        Booking[]
  conversations   Conversation[]

  @@unique([organizationId, id])
  // Único (organization_id, lower(email)) WHERE email IS NOT NULL AND
  // deleted_at IS NULL — índice único parcial; su versión actual (con
  // lower()) vive en la migración
  // 20260825120000_m13_case_insensitive_contact_email, con
  // manual_constraints.sql como red de seguridad idempotente además.
  // Los dos CHECK de calificación (lead_score en 0..100, lead_budget_amount
  // >= 0) viven en la migración 20260912120000 y NO en
  // manual_constraints.sql: B-15 sacó los CHECK de la reaplicación por deploy.
  @@index([organizationId])
  @@index([companyId])
  @@index([ownerId])
  @@index([lifecycleStage])
  @@index([organizationId, lifecycleStage])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Pipeline — proceso de ventas (MVP: uno por organización)
// ---------------------------------------------------------------------------

model Pipeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  stages        Stage[]
  opportunities Opportunity[]

  // Único (organization_id) WHERE is_default = true AND deleted_at IS NULL —
  // índice único parcial; vive en la migración
  // 20260821140000_incorporate_manual_ddl_into_migrations (C-2), con
  // manual_constraints.sql como red de seguridad idempotente además
  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("pipelines")
}

// ---------------------------------------------------------------------------
// Stage — etapa ordenada dentro de un Pipeline.
// organizationId denormalizado desde pipeline.organizationId (un stage nunca
// cambia de organización): evita depender de un join a Pipeline en cada
// query y en la política de RLS, igual que el resto de las entidades.
// deletedAt: soft delete, igual criterio que Company/Contact/Pipeline —
// necesario para que Opportunity (stageId obligatorio) pueda referenciar
// stages sin arriesgar una violación de integridad referencial al "borrar".
// ---------------------------------------------------------------------------

model Stage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String    @db.VarChar(100)
  order          Int
  probability    Decimal   @default(0) @db.Decimal(5, 2)
  isWon          Boolean   @default(false) @map("is_won")
  isLost         Boolean   @default(false) @map("is_lost")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  pipeline      Pipeline      @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organizationId, id])
  // Únicos (pipeline_id, order) y (pipeline_id, name) WHERE deleted_at IS NULL
  // — índices únicos parciales; viven en la migración
  // 20260821140000_incorporate_manual_ddl_into_migrations (C-2), con
  // manual_constraints.sql como red de seguridad idempotente además. Los dos
  // parciales sobre is_won/is_lost que nacieron ahí los borró
  // 20260910120000_stages_won_lost_no_exclusivos (docs/frontend-cambios-
  // pendientes.md §13): varias etapas del mismo pipeline pueden ser "ganada"
  // o "perdida" a la vez. El CHECK stages_won_lost_exclusive_check (una misma
  // etapa no puede ser las dos cosas) sigue vigente.
  @@index([organizationId])
  @@index([pipelineId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("stages")
}

// ---------------------------------------------------------------------------
// Opportunity — venta en curso
// ---------------------------------------------------------------------------

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  companyId         String?           @map("company_id") @db.Uuid
  contactId         String?           @map("contact_id") @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  pipelineId        String            @map("pipeline_id") @db.Uuid
  stageId           String            @map("stage_id") @db.Uuid
  title             String            @db.VarChar(255)
  amount            Decimal           @default(0) @db.Decimal(14, 2)
  currency          String            @default("USD") @db.VarChar(3)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  actualCloseDate   DateTime?         @map("actual_close_date") @db.Date
  status            OpportunityStatus @default(OPEN)
  lostReason        String?           @map("lost_reason") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  // -------------------------------------------------------------------------
  // Módulo de stock de vehículos. Los tres son nullables y sin default: una
  // oportunidad de un CRM que no vende autos no los completa nunca, y para
  // una automotora la oportunidad puede nacer antes de saber por qué unidad
  // se interesó el cliente. No hay CHECK "vehicleId obligatorio si la
  // organización usa el módulo" — la base no sabe qué organización usa qué.
  // -------------------------------------------------------------------------
  // La unidad por la que se interesó el cliente. FK compuesta y NO ACTION,
  // el mismo par que companyId/contactId: nullable -> NO ACTION por la regla
  // de 20260821140200, y vehicles usa soft delete, así que la acción nunca se
  // dispara en la práctica.
  vehicleId     String?                   @map("vehicle_id") @db.Uuid
  financingType OpportunityFinancingType? @map("financing_type")
  // Etiqueta manual, sin relación con Source (ver el comentario del enum).
  leadSource    OpportunityLeadSource?    @map("lead_source")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  owner        User         @relation("OpportunityOwner", fields: [organizationId, ownerId], references: [organizationId, id])
  pipeline     Pipeline     @relation(fields: [organizationId, pipelineId], references: [organizationId, id])
  stage        Stage        @relation(fields: [organizationId, stageId], references: [organizationId, id])
  vehicle      Vehicle?     @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: NoAction)

  activities Activity[]
  bookings   Booking[]

  @@unique([organizationId, id])
  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL) y
  // CHECK (amount >= 0) viven en la migración
  // 20260821140000_incorporate_manual_ddl_into_migrations (C-2) — y ya NO en
  // manual_constraints.sql: B-15 sacó los CHECK de la reaplicación por deploy
  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stageId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, pipelineId])
  // "Las oportunidades de esta unidad" — la pestaña de interesados de la ficha
  // del vehículo (Fase 2). Compuesto con organization_id y no (vehicle_id)
  // suelto, como los índices que nacieron después de A-6.
  @@index([organizationId, vehicleId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Activity — interacción unificada (CALL, MEETING, EMAIL, TASK, NOTE)
// ---------------------------------------------------------------------------

model Activity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  authorId       String       @map("author_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  opportunityId  String?      @map("opportunity_id") @db.Uuid
  subject        String       @db.VarChar(255)
  body           String?
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  author       User         @relation("ActivityAuthor", fields: [organizationId, authorId], references: [organizationId, id])
  assignee     User?        @relation("ActivityAssignee", fields: [organizationId, assigneeId], references: [organizationId, id], onDelete: NoAction)
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: NoAction)

  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL OR
  // opportunity_id IS NOT NULL) vive en la migración
  // 20260821140000_incorporate_manual_ddl_into_migrations (C-2) — y ya NO en
  // manual_constraints.sql: B-15 sacó los CHECK de la reaplicación por deploy
  @@index([organizationId])
  @@index([authorId])
  @@index([companyId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([organizationId, dueDate])
  @@index([assigneeId, completedAt])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("activities")
}

// ===========================================================================
// Capa de ingesta — ver docs/ingestion-architecture.md
//
// Principio rector (sección 1): ningún dato externo se escribe directo en una
// tabla de negocio. Todo aterriza primero en IngestionEvent con su payload
// crudo intacto, y recién después de validar y mapear se promueve a Contact.
//
// Las tres tablas nacen con las FKs compuestas por organización que C-3
// impuso al resto del schema, y con los índices que sirven a su patrón de
// consulta real — el error que A-6 encontró en las 6 entidades existentes no
// se repite acá.
// ===========================================================================

// ---------------------------------------------------------------------------
// Source — una instancia concreta de integración: "landing page de precios",
// "Excel de la feria de marzo", "Postgres del cliente X".
//
// isActive vs. deletedAt — mismo criterio que en User, no son redundantes:
//   - isActive = false: integración pausada. Reversible, sigue visible en la
//     UI y su historial de eventos sigue consultable.
//   - deletedAt != null: la fuente se removió de la organización. Terminal.
// El borrado físico no es una alternativa: ingestion_events -> sources es
// RESTRICT justamente para no perder la auditoría de origen, así que una
// Source que ya ingestó algo no se puede borrar. Sin deletedAt, la lista de
// fuentes de una organización solo podría crecer.
//
// El listado por defecto se apoya en un índice PARCIAL
// (organization_id, created_at) WHERE deleted_at IS NULL — el DSL de Prisma no
// expresa índices parciales, así que se crea en la migración, igual que los 8
// únicos parciales del schema.
// ---------------------------------------------------------------------------

model Source {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String     @db.VarChar(255)
  type           SourceType
  fieldMapping   Json?      @map("field_mapping")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  apiKeys         ApiKey[]
  ingestionEvents IngestionEvent[]

  // Sin @@index([organizationId]) suelto: un btree sobre (organization_id,
  // created_at) ya sirve cualquier WHERE organization_id = ?, así que el
  // índice de una sola columna sería peso muerto. Las 6 entidades existentes
  // lo tienen porque nacieron sin el compuesto (A-6); esta no.
  @@unique([organizationId, id])
  @@map("sources")
}

// ---------------------------------------------------------------------------
// ApiKey — credencial de ingesta. Invariante de la sección 3: una API key
// resuelve a exactamente una organización, siempre. Nunca a varias, nunca a
// ninguna.
//
// keyHash: la clave se guarda hasheada, nunca en claro, y se muestra una sola
// vez al crearla. El algoritmo lo decide el ítem 3 (gestión de API keys), por
// eso la columna es text y no un VarChar dimensionado para uno en concreto.
// El @unique no es cosmético: authenticateApiKey busca por hash SIN conocer
// todavía la organización, así que la unicidad tiene que ser global.
//
// keyPrefix: los primeros caracteres, visibles, para identificar la clave en
// la UI sin exponer el resto.
//
// Sin deletedAt, mismo criterio que Invitation: revokedAt YA es el estado
// terminal y tiene nombre propio; un deletedAt encima obligaría a explicar en
// qué se diferencia de él, sin buena respuesta.
// ---------------------------------------------------------------------------

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix") @db.VarChar(16)
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  source       Source       @relation(fields: [organizationId, sourceId], references: [organizationId, id])

  // (organization_id, source_id, created_at) cubre dos cosas con un solo
  // índice: el lado REFERENCIANTE de la FK compuesta —que Postgres no indexa
  // por su cuenta— y el listado "claves de esta fuente" ya ordenado. Sin
  // sort: Desc a propósito: un btree se recorre hacia atrás al mismo costo, y
  // el orden declarado solo importaría para un ORDER BY de direcciones mixtas.
  //
  // No hay (organization_id, created_at) aparte: el listado de claves de una
  // organización son unas pocas filas, el prefijo (organization_id) de este
  // índice ya las trae, y ordenarlas en memoria es gratis.
  @@index([organizationId, sourceId, createdAt])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// IngestionEvent — una fila por cada intento de ingesta, con el payload crudo
// intacto. Es la tabla de staging de la sección 1 y la de mayor volumen del
// schema.
//
// Sin deletedAt: es un registro de auditoría append-only. Borrarlo lógicamente
// no significa nada —o está y vale, o se purga de verdad— y una columna que
// nadie escribe pesa en millones de filas. La retención se resuelve con un
// DELETE por created_at + status, sin ninguna columna nueva; ver la sección
// 9.1 del documento de ingesta, que además explica por qué particionar esta
// tabla por fecha es incompatible con la idempotencia de acá abajo.
//
// Dos índices viven en la migración porque son PARCIALES y el DSL de Prisma no
// los expresa:
//   - UNIQUE (source_id, external_id) WHERE external_id IS NOT NULL — la
//     restricción crítica que hace idempotente la ingesta.
//   - (created_at) WHERE status = 'PENDING' — la cola del worker.
// ---------------------------------------------------------------------------

model IngestionEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  sourceId          String          @map("source_id") @db.Uuid
  externalId        String?         @map("external_id") @db.VarChar(255)
  rawPayload        Json            @map("raw_payload")
  status            IngestionStatus @default(PENDING)
  errorMessage      String?         @map("error_message")
  // Reintentos ante un error de SISTEMA (B-30) — espejo de OutboxEvent, mismo
  // significado campo por campo: attempts sube en cada fallo de sistema y
  // decide el paso a DEAD_LETTER; nextAttemptAt NULL es "reclamable ya".
  // lastError es de ESTE mecanismo y NO reemplaza a errorMessage, que sigue
  // significando una sola cosa: por qué falló el dato cuando la fila está en
  // FAILED.
  attempts          Int             @default(0)
  nextAttemptAt     DateTime?       @map("next_attempt_at")
  lastError         String?         @map("last_error")
  promotedContactId String?         @map("promoted_contact_id") @db.Uuid
  // Registro de lo que la promoción decidió sin fallar: campos donde el CRM y
  // el dato entrante diferían y ganó el CRM (§4, "nunca sobrescribir en
  // silencio"), y contactos sin email marcados para revisión manual. Es
  // información de filas PROCESSED, por eso NO vive en errorMessage — que
  // significa una sola cosa, por qué falló. Forma en src/types/promotion.ts.
  promotionNotes    Json?           @map("promotion_notes")
  // Agrupa las filas de UNA importación de archivo (ítem 5). NULL significa
  // "no vino de un lote": los eventos del webhook llegan de a uno y quedan en
  // null para siempre. Los contadores de §5 se derivan con un GROUP BY sobre
  // esta columna, no se persisten aparte — ver la migración 20260825160000.
  batchId           String?         @map("batch_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  source          Source       @relation(fields: [organizationId, sourceId], references: [organizationId, id])
  promotedContact Contact?     @relation(fields: [organizationId, promotedContactId], references: [organizationId, id], onDelete: NoAction)

  // Lado referenciante de la FK compuesta a sources, y la consulta de
  // resultado de lote de la sección 5 (cuántos entraron / se promovieron /
  // fallaron para una fuente), incluido su GROUP BY status.
  //
  // No hay índice sobre (organization_id, promoted_contact_id): Postgres solo
  // lo necesitaría para abaratar un DELETE/UPDATE del padre, y contacts usa
  // soft delete — su (organization_id, id) no cambia ni se borra nunca. Sin
  // consulta que lo use, es peso muerto en la tabla de mayor volumen.
  @@index([organizationId, sourceId, createdAt])
  // El resultado de un lote (§5): WHERE organization_id = ? AND batch_id = ?,
  // con GROUP BY status encima. Sin esto sería un seq scan sobre la tabla de
  // mayor volumen del esquema.
  @@index([organizationId, batchId])
  @@map("ingestion_events")
}

// ===========================================================================
// Motor de eventos salientes (outbox) — P1 de docs/roadmap-implementacion.md
//
// La contracara de IngestionEvent: aquella tabla es lo que el CRM RECIBE, ésta
// es lo que el CRM EMITE. El patrón es el mismo a propósito —fila de staging,
// worker con polling, reclamo con FOR UPDATE SKIP LOCKED— porque ya está
// probado en este repositorio y no había razón para inventar otro.
//
// POR QUÉ EXISTE: hoy no hay ningún mecanismo para que el CRM avise "esto
// pasó". Lo necesitan tres cosas que todavía no existen —el aviso a Resea para
// el QR de reseña, el recordatorio de WhatsApp antes de un turno, y el trigger
// "Oportunidad → Ganada" del motor de automatizaciones— y se construye una vez,
// genérico, antes de cablear cualquiera de las tres.
// ===========================================================================

// ---------------------------------------------------------------------------
// OutboxEvent — un evento de negocio que hay que entregar hacia afuera.
//
// EL PUNTO DEL PATRÓN, y lo único que no se puede aflojar: la fila se escribe
// DENTRO de la misma transacción que el cambio de negocio que la origina (ver
// emitOutboxEvent). O se guardan los dos, o no se guarda ninguno. Sin eso, un
// proceso que muere entre el commit del negocio y el envío del aviso pierde el
// aviso para siempre, y no queda rastro de que faltó.
//
// SIN deletedAt: es un registro append-only, igual que IngestionEvent. Borrarlo
// lógicamente no significa nada —o está pendiente, o ya se entregó, o murió— y
// la retención se resuelve con un DELETE físico por created_at + status (ver
// scripts/purge-outbox-events.ts).
//
// eventType es un String libre y el motor NO lo interpreta: quien emite decide
// el valor ("opportunity.won", "booking.reminder_due") y el registro de
// handlers decide quién lo atiende. El motor solo transporta.
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  payload        Json
  status         OutboxStatus @default(PENDING)
  // Cuántas veces se intentó entregar. Nace en 0 y solo sube: es lo que decide
  // cuándo se agotan los reintentos y el evento pasa a DEAD_LETTER.
  attempts       Int          @default(0)
  // NULL significa "reclamable ya" — es el estado de un evento recién emitido,
  // que nunca se intentó. Después de un fallo pasa a llevar la fecha del
  // próximo intento, calculada con backoff.
  nextAttemptAt  DateTime?    @map("next_attempt_at")
  // El último error de entrega, para poder diagnosticar un DEAD_LETTER sin
  // tener que reproducirlo.
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  // (organization_id, created_at) DESDE EL ARRANQUE, sin esperar a que alguien
  // lo audite: es la lección de ALTO-6, donde las 6 entidades de negocio
  // nacieron sin el índice de su propio listado y hubo que agregarlo tres meses
  // después. Sirve cualquier "los eventos de esta organización, más recientes
  // primero", que es como se va a mirar esta tabla desde afuera del worker.
  //
  // Sin @@index([organizationId]) suelto: un btree sobre (organization_id,
  // created_at) ya sirve cualquier WHERE organization_id = ?, así que el índice
  // de una sola columna sería peso muerto. Mismo criterio que la capa de
  // ingesta.
  //
  // El índice de la COLA —el que sirve "candidatos a reclamar"— es parcial y
  // sobre una expresión, dos formas que el DSL de Prisma no expresa: vive en la
  // migración 20260828150000.
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

// Módulo de Agenda/Booking — P2.1 de docs/roadmap-implementacion.md
//
// Primer tramo: las entidades de configuración (Branch, Resource, ServiceType).
// SIN Google Calendar y SIN Booking todavía — el resto de P2.1 viene después.
// ===========================================================================

// ---------------------------------------------------------------------------
// Branch — sucursal. Prerrequisito que el diseño daba por existente y no
// existía: docs/booking-architecture.md §3 modela Resource/ServiceType/Booking
// con organizationId + sucursalId, pero no había ninguna entidad de sucursal en
// este schema (verificado con grep sobre el archivo completo: cero
// coincidencias).
//
// SE LLAMA Branch, NO Sucursal. El schema es 100% inglés —Organization,
// Contact, Pipeline, Stage— y el `sucursalId` del documento de diseño es un
// desliz de redacción, no una decisión. La prosa de los documentos sigue
// diciendo "sucursal", igual que dice "organización" para Organization.
//
// ALCANCE ACOTADO, Y ES UNA DECISIÓN, NO UNA ETAPA INTERMEDIA: por ahora SOLO
// las entidades de Booking tienen branchId. Contact, Company, Opportunity,
// Activity, Pipeline y Stage NO lo tienen y no se preparó nada para que lo
// tengan. Sucursalizar el resto del CRM es una decisión mucho más grande —toca
// el aislamiento de todas las lecturas, no solo el modelo— y no se asume de
// antemano.
//
// SIN SUCURSAL OBLIGATORIA: el onboarding no crea ninguna. Una organización que
// no usa Booking tiene cero Branch y ese es un estado válido. No hay invariante
// de "al menos una sucursal activa" — a diferencia de "al menos un pipeline
// activo" (H-1), acá nada se rompe con cero.
//
// FK a Organization de columna simple, como todas: `organizations` tiene `id`,
// no `organization_id`, así que no existe una versión compuesta de esa
// relación. Las compuestas que impuso C-3 son las CRUZADAS entre entidades
// tenant-scoped, y las de este módulo (Resource/ServiceType -> Branch,
// ServiceType -> Resource) sí lo son.
// ---------------------------------------------------------------------------

model Branch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  // Zona horaria IANA de la sucursal ("America/Argentina/Buenos_Aires").
  // §4 del documento de diseño es explícito: cada sucursal necesita la suya y
  // NO se asume la del servidor. Se agrega ahora, antes de que Google Calendar
  // exista, para no migrar de nuevo cuando llegue — a diferencia de
  // googleCalendarId, que sí se dejó afuera: aquello es una columna que no
  // significa nada hasta que haya integración, esto es un dato del negocio que
  // ya se puede cargar y ya es correcto.
  //
  // El default "UTC" y el VarChar(50) replican Organization.timezone, para que
  // las dos tablas describan el mismo dato de la misma forma. El API igual la
  // EXIGE al crear (ver branch.controller.ts): una sucursal silenciosamente en
  // UTC produce turnos a la hora equivocada, y el default acá es una red de
  // seguridad del esquema, no la forma esperada de usarlo.
  timezone       String    @default("UTC") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  resources    Resource[]
  serviceTypes ServiceType[]

  // Singular y opcional: el @unique sobre branch_id del otro lado convierte esta
  // relación en 1-a-lo-sumo-1, y Prisma la tipa así.
  googleCalendarConnection GoogleCalendarConnection?

  bookings Booking[]

  // Módulo de Agentes de IA: los agentes configurados para esta sucursal y
  // las conversaciones que atendieron (branchId denormalizado desde Agent).
  agents        Agent[]
  conversations Conversation[]

  // Módulo QR: los QR digitales de esta sucursal.
  qrCodes QrCode[]

  // Módulo de stock de vehículos: las unidades que están en esta sucursal.
  // Es la SEGUNDA entidad fuera de Booking que cuelga de Branch (la primera
  // fue QrCode), y sigue sin cambiar el alcance acotado de arriba: Contact,
  // Company, Opportunity y Activity siguen sin branchId.
  vehicles Vehicle[]

  // El UNIQUE que habilita las FKs compuestas de sus hijos (C-3).
  @@unique([organizationId, id])
  // (organization_id, created_at) desde el arranque, sin esperar a que alguien
  // lo audite: es la lección de ALTO-6, donde las 6 entidades de negocio
  // nacieron sin el índice de su propio listado.
  @@index([organizationId, createdAt])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Resource — lo que se agenda: una persona, un espacio o una clase.
//
// SIN googleCalendarId todavía. Llega recién con la integración: una columna
// nullable que nadie escribe durante meses no aporta nada y sí hay que
// explicarla en cada revisión.
// ---------------------------------------------------------------------------

model Resource {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  name           String       @db.VarChar(255)
  type           ResourceType
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])

  serviceTypes ServiceType[]
  workingHours WorkingHours[]
  bookings     Booking[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  // (organization_id, branch_id) sirve las dos consultas que de verdad
  // existen: "los recursos de esta sucursal" —el filtro más frecuente de este
  // listado— y el conteo del RESTRICT de deleteBranch. NO se agrega por ser el
  // lado referenciante de la FK: Postgres solo lo necesitaría para abaratar un
  // DELETE del padre, y branches usa soft delete, así que su
  // (organization_id, id) no cambia ni se borra nunca. Mismo criterio ya
  // aplicado en ingestion_events.
  @@index([organizationId, branchId])
  @@map("resources")
}

// ---------------------------------------------------------------------------
// ServiceType — qué se puede reservar sobre un Resource, con su duración y su
// cupo.
//
// capacity = 1 es un turno exclusivo; capacity > 1 es una clase con cupo. El
// control de capacidad al reservar es lógica de este CRM (§3 del documento), no
// algo que se delegue al proveedor de calendario — pero eso llega con Booking,
// que todavía no existe.
//
// INVARIANTE QUE EL DOCUMENTO NO MENCIONA y que el service impone: el branchId
// de un ServiceType tiene que coincidir con el branchId de su Resource. Un
// servicio "de la sucursal A" que usa un recurso de la B es un dato
// inconsistente que nadie ve hasta que alguien intenta reservar. Se valida con
// el mismo patrón que Opportunity ya usa para Stage/Pipeline (validateStageId).
//
// La FK compuesta a resources garantiza la ORGANIZACIÓN, no la sucursal: no hay
// forma de expresar "y además la misma sucursal" en una FK sin denormalizar más
// columnas. Por eso la validación vive en el service y tiene test propio.
// ---------------------------------------------------------------------------

model ServiceType {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  resourceId     String    @map("resource_id") @db.Uuid
  name           String    @db.VarChar(255)
  // Duración en minutos. El > 0 se valida en Zod y además con un CHECK en la
  // migración: un servicio de 0 minutos no es un servicio, y la defensa que
  // sobrevive a un camino de escritura futuro que no pase por el controller es
  // la de la base.
  durationMin    Int       @map("duration_min")
  // 1 = turno exclusivo, N = clase con cupo. Mismo criterio que durationMin
  // para el >= 1.
  capacity       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])

  bookings Booking[]

  // AHORA SÍ: Booking lo referencia con una FK compuesta, así que este UNIQUE
  // dejó de ser un objeto sin uso y pasó a ser el que la habilita. Es el tercero
  // de los tres pendientes que PR #41 dejó anotados (los otros dos son el count
  // real de contarReservasActivas y el lock de deleteServiceType, los dos
  // cerrados en este mismo PR).
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, branchId])
  // Sirve el conteo del RESTRICT de deleteResource.
  @@index([organizationId, resourceId])
  @@map("service_types")
}

// ---------------------------------------------------------------------------
// GoogleCalendarConnection — la autorización OAuth de UNA sucursal contra UNA
// cuenta de Google (docs/booking-architecture.md §4, paso 2 de §9).
//
// UNA FILA POR SUCURSAL, y branch_id es UNIQUE a nivel base, no solo por
// convención del service: reconectar una sucursal ACTUALIZA su fila, nunca crea
// una segunda. Sin ese UNIQUE, dos callbacks concurrentes dejarían dos filas
// ACTIVE y nada podría decidir cuál es la buena.
//
// EL refreshToken ES NULLABLE, y eso es la mitad de la política de secretos de
// esta tabla: una conexión REVOKED no tiene token, no tiene un token vacío. Al
// desconectar se pone en NULL, así que un volcado de la base no arrastra
// credenciales de sucursales que ya se fueron. El CHECK de la migración sostiene
// la otra mitad: una fila ACTIVE SIN token es imposible.
// ---------------------------------------------------------------------------
model GoogleCalendarConnection {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  // CIFRADO EN REPOSO con AES-256-GCM (src/utils/encryption.ts) — NUNCA en
  // claro, y NUNCA en una respuesta de la API.
  //
  // ATENCIÓN AL LEER docs/booking-architecture.md §3/§4: aquello dice "mismo
  // criterio que ApiKey" y esa premisa es FALSA. ApiKey no está cifrada: está
  // HASHEADA con SHA-256 sin sal (src/utils/apiKey.ts), que es irreversible a
  // propósito porque una API key solo hay que RECONOCERLA. Un refresh token hay
  // que RECUPERARLO para poder usarlo contra Google, así que hashearlo lo
  // volvería inútil. Son dos problemas distintos con dos primitivos distintos.
  refreshToken String? @map("refresh_token")

  // El calendario sobre el que opera esta sucursal. "primary" es el calendario
  // principal de la cuenta que autorizó; el negocio puede elegir otro.
  calendarId String @default("primary") @map("calendar_id") @db.VarChar(255)

  status ConnectionStatus @default(ACTIVE)

  // Por qué esta conexión dejó de funcionar. No hay ningún mecanismo de aviso al
  // admin todavía (§4 lo pide, no existe), así que el registro en la fila ES la
  // notificación: sin esto, "status = ERROR" no dice si el usuario revocó el
  // acceso desde su cuenta de Google, si el calendario se borró, o si Google
  // estaba caído — tres cosas con tres respuestas distintas.
  //
  // VarChar(500) y no `text`: lo que se guarda acá es el `error` +
  // `error_description` de Google, no un stack. El tope obliga a truncar en el
  // service en vez de dejar que una respuesta inesperadamente larga entre entera.
  lastErrorAt      DateTime? @map("last_error_at")
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(500)

  // Cuándo se autorizó POR ÚLTIMA VEZ, distinto de createdAt: reconectar
  // actualiza la fila existente, así que createdAt sigue diciendo cuándo esta
  // sucursal conectó Google por primera vez y connectedAt cuándo vale el token
  // que hay guardado ahora.
  connectedAt DateTime @default(now()) @map("connected_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // -------------------------------------------------------------------------
  // SINCRONIZACIÓN INVERSA (paso 4 de docs/booking-architecture.md §9)
  //
  // Los cuatro son NULLABLE porque una conexión recién creada NO tiene canal: el
  // flujo OAuth del paso 2 no crea ninguno. Lo crea el worker de renovación en
  // su siguiente pasada, que trata "sin canal" y "con canal por vencer" como el
  // mismo caso. Ver googleCalendarChannelWorker.ts.
  // -------------------------------------------------------------------------

  // El id que NOSOTROS le damos al canal (un UUID). Google lo devuelve en cada
  // notificación como X-Goog-Channel-ID, y es por donde se encuentra esta fila.
  //
  // @unique: dos conexiones no pueden compartir canal, y es lo que hace que
  // buscar por channelId devuelva una fila o ninguna, nunca varias.
  channelId String? @unique @map("channel_id") @db.Uuid

  // El id OPACO que asigna Google al recurso observado. No es nuestro y no se
  // puede derivar: viene en la respuesta de events.watch y es OBLIGATORIO para
  // poder llamar a channels.stop más tarde (ese endpoint pide id + resourceId,
  // verificado contra la referencia). Sin guardarlo, un canal no se puede
  // detener nunca — solo esperar a que venza.
  channelResourceId String? @map("channel_resource_id") @db.VarChar(255)

  // Cuándo vence el canal. Google lo devuelve como timestamp Unix en
  // MILISEGUNDOS (no segundos) y el TTL por defecto es 604800 s = 7 días
  // exactos, verificado contra la referencia de events.watch.
  channelExpiration DateTime? @map("channel_expiration")

  // El token de sincronización incremental de events.list. Con él, Google
  // devuelve SOLO lo que cambió desde la última vez — incluidos los eventos
  // cancelados, que en una lista normal no aparecerían.
  //
  // NULL significa "nunca se sincronizó": la primera notificación hace una
  // sincronización completa solo para obtener un token, sin reconciliar hacia
  // atrás. Lo mismo pasa cuando Google lo invalida con un 410.
  //
  // Sin límite de longitud: Google no especifica el tamaño de estos tokens.
  syncToken String? @map("sync_token")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])

  // EL UNIQUE QUE SOSTIENE "UNA CONEXIÓN POR SUCURSAL", y es compuesto y no un
  // @unique suelto sobre branchId por un requisito de Prisma: el lado
  // definidor de una relación 1-a-1 tiene que ser único SOBRE LOS MISMOS CAMPOS
  // que usa la relación, y la de acá abajo es (organizationId, branchId).
  //
  // Garantiza exactamente lo mismo que un unique sobre branch_id solo, y no por
  // convención sino por construcción: la FK compuesta obliga a que el
  // organization_id de esta fila sea el de SU sucursal, y branches.id es la PK
  // —un solo organization_id posible por branch_id—, así que dos filas con el
  // mismo branch_id colisionan en este índice sí o sí. Un unique adicional sobre
  // branch_id sería un segundo índice para la misma garantía.
  @@unique([organizationId, branchId])
  // Sirve la pasada del worker de renovación: "conexiones ACTIVE cuyo canal
  // falta o vence pronto". Sin él, esa consulta es un scan de la tabla en cada
  // tick — barato hoy (una fila por sucursal) y no dentro de un año.
  //
  // Por (status, channel_expiration) y no al revés: el filtro por status es el
  // que descarta más filas de entrada, y channel_expiration se compara por rango
  // (< ahora + margen), que es lo que un btree resuelve en el ÚLTIMO lugar.
  // Invertido, el rango dejaría el status sin poder usarse para acotar.
  @@index([status, channelExpiration])
  // SIN (organization_id, created_at), a diferencia de branches/resources/
  // service_types, y es una decisión y no un olvido: la lección de ALTO-6 es
  // sobre el índice del LISTADO de una entidad, y acá no hay listado. Todo
  // acceso a esta tabla es por sucursal —una fila— y lo sirve el UNIQUE de acá
  // arriba, incluido el conteo del RESTRICT de deleteBranch. Mismo criterio con
  // el que service_types se quedó sin su @@unique: no se agregan objetos que
  // nadie usa.
  @@map("google_calendar_connections")
}

// ---------------------------------------------------------------------------
// WorkingHours — el horario semanal recurrente de un Resource (P2.1, paso 3).
//
// UNA FILA = UNA FRANJA de un día. "Lunes de 9 a 13 y de 16 a 20" son DOS filas,
// las dos con weekday = MONDAY. Es lo que permite el horario partido, que es la
// forma normal de trabajar de una peluquería o un consultorio, y por eso NO hay
// un @@unique([resourceId, weekday]).
//
// POR RESOURCE Y NO POR BRANCH: decisión tomada, cada recurso puede tener su
// propio horario (un barbero trabaja martes a sábado, otro lunes a viernes, en
// la misma sucursal).
//
// ALCANCE MÍNIMO A PROPÓSITO — sin excepciones, sin feriados y sin bloqueos
// puntuales. Mismo criterio con el que Branch nació sin nada opcional: se
// agregan cuando alguien los necesite. Lo que hoy NO se puede expresar y hay que
// tener presente: "el 25 de diciembre no atiendo" y "este martes me tomo la
// tarde" no tienen representación; el horario es puramente semanal.
//
// LA HORA ES LOCAL DE LA SUCURSAL, NO UTC. `weekday` + `startMinute` son
// hora de pared en la zona IANA de Branch.timezone. Convertirlas a instantes
// concretos exige una fecha y la zona, y eso vive en src/utils/workingHours.ts
// (con Luxon, por el horario de verano). Guardar UTC acá sería directamente un
// error: "los lunes a las 9" no es un instante, y en una zona con DST no
// corresponde siempre al mismo UTC.
// ---------------------------------------------------------------------------
model WorkingHours {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  resourceId     String  @map("resource_id") @db.Uuid
  weekday        Weekday

  // MINUTOS DESDE LA MEDIANOCHE LOCAL, no `time` de Postgres y no "HH:MM".
  //
  // Contra `@db.Time`: Prisma lo mapea a DateTime, así que del otro lado llega
  // un Date parado en el 1/1/1970 del que hay que extraer la hora igual — un
  // tipo más rico que no aporta nada y sí invita a operar con él como si fuera
  // un instante.
  //
  // Contra "HH:MM" en VarChar: toda la lógica de este módulo es aritmética
  // (¿entra un turno de 30 minutos?, ¿se superponen dos franjas?), y un entero
  // es la representación honesta de eso. La API sí habla "HH:MM" — la
  // conversión vive en el borde, en workingHours.controller.ts.
  //
  // Rango 0..1440. El 1440 es medianoche del día siguiente y existe para poder
  // expresar una franja que termina a las 24:00; los CHECK de la migración
  // sostienen 0 <= start < end <= 1440.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])

  // SIN deletedAt: no es una entidad de negocio que se archive, es la
  // configuración vigente de un recurso. El endpoint la REEMPLAZA entera (ver
  // workingHours.service.ts), así que una fila vieja no significa nada — mismo
  // criterio que GoogleCalendarConnection, que tampoco lo tiene.
  //
  // (organization_id, resource_id) sirve la única consulta que existe: "el
  // horario de este recurso", que es lo que leen la disponibilidad y la
  // validación de POST /api/bookings. No hay listado por organización.
  @@index([organizationId, resourceId])
  @@map("working_hours")
}

// ---------------------------------------------------------------------------
// Booking — una reserva (docs/booking-architecture.md §3, paso 3 de §9).
//
// ES LA FUENTE DE VERDAD, y eso es una decisión de §4 y no una consecuencia:
// Google Calendar es un reflejo. Un Booking se guarda aunque Google falle o
// aunque la sucursal no tenga Google conectado — en esos casos googleEventId
// queda en NULL y la reserva vale igual.
//
// SIN deletedAt: cancelar es un `status`, no un borrado. Una reserva cancelada
// es historia que hay que conservar (el cliente canceló, eso pasó), y un soft
// delete agregaría un quinto estado que no significa nada distinto de CANCELLED.
// Mismo razonamiento que GoogleCalendarConnection.
// ---------------------------------------------------------------------------
model Booking {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  serviceTypeId  String @map("service_type_id") @db.Uuid
  resourceId     String @map("resource_id") @db.Uuid

  // NOT NULL: una reserva sin contacto no es una reserva — alguien la pidió.
  // Es la diferencia con Opportunity/Activity, donde contactId es opcional
  // porque aquellas pueden colgar de una Company.
  contactId String @map("contact_id") @db.Uuid

  // Vínculo opcional con el pipeline comercial (§3). Nullable, y por eso su FK
  // es NO ACTION y no RESTRICT — la regla de 20260821140200.
  opportunityId String? @map("opportunity_id") @db.Uuid

  // INSTANTES REALES (timestamp con zona, UTC), a diferencia de WorkingHours.
  // Acá sí corresponde: una reserva ocurre en un momento concreto. La zona de la
  // sucursal se usa para MOSTRARLA y para calcular contra el horario de trabajo,
  // no para guardarla.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  status BookingStatus @default(CONFIRMED)

  // Id del evento en Google Calendar. NULL es un estado NORMAL y esperado, no
  // un error: la sucursal puede no tener Google conectado, o la llamada puede
  // haber fallado — §4 es explícito en que eso no bloquea la reserva.
  googleEventId String? @map("google_event_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  serviceType  ServiceType  @relation(fields: [organizationId, serviceTypeId], references: [organizationId, id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: NoAction)

  // LA CONSULTA CALIENTE DEL MÓDULO: "¿qué reservas del recurso R se superponen
  // con [inicio, fin)?". La responden la validación de capacidad de
  // POST /api/bookings y el cálculo de disponibilidad, que son los dos caminos
  // que corren en cada reserva. Sin este índice, cada una es un scan de la tabla
  // de mayor crecimiento del módulo.
  @@index([organizationId, resourceId, startsAt])
  // Sirve el conteo del RESTRICT de deleteServiceType (reservas CONFIRMED de un
  // servicio) y la capacidad por servicio.
  @@index([organizationId, serviceTypeId, startsAt])
  // "Las reservas de este contacto" — la vista de ficha de cliente.
  @@index([organizationId, contactId])
  // La agenda: "las reservas de esta organización entre dos fechas".
  @@index([organizationId, startsAt])
  // ÚNICO Y PARCIAL: bookings_org_google_event_unique sobre (organization_id,
  // google_event_id) WHERE google_event_id IS NOT NULL — el DSL de Prisma no
  // expresa el predicado, vive en la migración
  // 20260902140000_bookings_google_event_id_unique. Nació como índice NO único
  // por rendimiento (M-7 de docs/auditoria-2026-08-29.md, migración
  // 20260902120000: sirve a findBookingByGoogleEventId, que aplicarCambio llama
  // una vez por cada evento cambiado de Google y que sin índice escaneaba el
  // tenant entero) y V-4 lo volvió UNIQUE: findFirst sin orderBy +
  // markBookingCancelled cancelarían UNA reserva cualquiera si dos compartieran
  // el id, y la conexión con Google es por sucursal —dos cuentas de Google de
  // la misma organización son dos calendarios cuyos ids Google genera de forma
  // independiente—. Los NULL quedan afuera: una reserva sin Google es normal.
  // Lo afirma la fila 7 de docs/auditoria-2026-08-21-diagnostico.sql.
  @@map("bookings")
}

// ═══════════════════════════════════════════════════════════════════════════
// Módulo de Agentes de IA (docs/ai-agent-architecture.md) — paso 1 de §9.
//
// SOLO SCHEMA por ahora, mismo criterio que la calificación del lead en
// Contact (20260912120000): ningún controller, service ni loop de
// orquestación lee o escribe estas tablas todavía. Eso es el paso 2 del plan.
//
// Va acá, a continuación de Booking, porque es la siguiente pieza del mismo
// módulo de negocio: el agente es quien va a llamar a get_availability() /
// create_booking() (§7 del documento).
//
// SIN políticas RLS propias, y no es una omisión: bookings, working_hours,
// resources, service_types y google_calendar_connections —el módulo
// arquitectónicamente más parecido a este— tampoco las tienen. La defensa
// principal es, como en todo el schema, el filtro por organizationId en cada
// query (ver prisma/sql/rls_policies.sql).
// ═══════════════════════════════════════════════════════════════════════════

// ---------------------------------------------------------------------------
// Agent — un agente de IA configurado por una sucursal (§3).
//
// branchId NO es @unique a propósito: el documento de visión permite más de un
// agente por negocio (ventas, soporte, recepción, postventa), aunque el plan
// solo vaya a crear uno ("Agente comercial") por sucursal al principio. El
// ruteo entre varios activos es decisión abierta (§10); hoy no hay nada que
// rutear.
//
// CON deletedAt, a diferencia de Conversation y Message: un Agent es
// configuración que un ADMIN da de alta y de baja, no historia. Baja lógica,
// igual que Resource/ServiceType.
// ---------------------------------------------------------------------------
model Agent {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  name         String  @db.VarChar(200)
  // Resumen corto para el panel de admin. El prompt real es `instructions`.
  goal         String? @db.VarChar(500)
  // El prompt real: objetivo + tono + contexto del negocio, en texto libre.
  instructions String  @db.Text
  // "formal", "cercano" — informativo; se compone dentro de `instructions`.
  tone         String? @db.VarChar(100)

  // String y no enum, los dos: el catálogo de proveedores y de modelos cambia
  // más rápido de lo que conviene versionar en un enum de Postgres (mismo
  // criterio que Opportunity.currency). Zod los valida en el borde cuando
  // exista el endpoint.
  modelProvider String @map("model_provider") @db.VarChar(50)
  modelName     String @map("model_name") @db.VarChar(100)

  // Subconjunto del catálogo de tools de §7 ("create_opportunity",
  // "get_availability", ...). Es la primera de las cuatro comprobaciones de
  // puedeEjecutarTool() en §6. Sin FK a un catálogo: el catálogo vive en
  // código, no en la base.
  enabledTools String[]              @map("enabled_tools")
  // En qué canales puede operar este agente.
  channels     ConversationChannel[]

  // Forma esperada documentada en §6 (temas prohibidos, acciones prohibidas,
  // info no modificable, condiciones de derivación, promesas prohibidas,
  // datos requeridos antes de una acción) — NO impuesta por Postgres, mismo
  // criterio que Contact.customFields: cada negocio va a necesitar una
  // combinación distinta y fijarla en columnas sería inventar una forma que no
  // le sirve a todos. NOT NULL sin default: un agente sin guardrails
  // declarados no debería poder existir, aunque su valor sea `{}`.
  guardrails Json

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])

  conversations Conversation[]

  // El UNIQUE que habilita la FK compuesta de conversations (C-3).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Conversation — un hilo entre un contacto y un agente por un canal (§3).
//
// SIN deletedAt: "cerrada" es un `status` (CLOSED), no un soft delete — mismo
// criterio que Booking con BookingStatus.CANCELLED. Una conversación cerrada
// es historia que hay que conservar tal cual, y un soft delete agregaría un
// cuarto estado que no significa nada distinto de CLOSED.
//
// agentId NO cambia en un handoff: transferir a una persona es cambiar el
// status a TRANSFERRED_TO_HUMAN y completar assignedUserId. agentId sigue
// diciendo qué agente la venía atendiendo, para la auditoría. Pasar de un
// agente a OTRO agente es un caso distinto, no diseñado.
// ---------------------------------------------------------------------------
model Conversation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  // Denormalizado desde agentId, mismo criterio que Stage.organizationId:
  // evita un join para aislamiento y para la bandeja por sucursal.
  branchId       String @map("branch_id") @db.Uuid
  agentId        String @map("agent_id") @db.Uuid

  // NOT NULL: una conversación sin contacto no es una conversación — mismo
  // criterio que Booking.contactId. La FK es RESTRICT por la regla de
  // 20260821140200 (columna NOT NULL), y no NO ACTION.
  contactId String @map("contact_id") @db.Uuid

  // Se completa solo cuando status = TRANSFERRED_TO_HUMAN (§6): por ahora el
  // ownerId del Contact si tiene uno; si no, queda NULL y un vendedor la toma
  // desde la bandeja de Actividades. Nullable, y por eso su FK es NO ACTION.
  assignedUserId String? @map("assigned_user_id") @db.Uuid

  channel ConversationChannel
  status  ConversationStatus  @default(ACTIVE)

  // Id del hilo en el canal externo (WhatsApp: el número del contacto; Web: el
  // id de sesión del widget). Nullable: el canal Web puede no tener uno hasta
  // que el widget exista.
  externalThreadId String?   @map("external_thread_id") @db.VarChar(255)
  // Cache denormalizado del createdAt del último Message, para ordenar un
  // futuro listado sin agregar sobre messages. Lo mantiene el loop del paso 2.
  lastMessageAt    DateTime? @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  agent        Agent        @relation(fields: [organizationId, agentId], references: [organizationId, id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  assignedUser User?        @relation("ConversationAssignee", fields: [organizationId, assignedUserId], references: [organizationId, id], onDelete: NoAction)

  messages Message[]

  // El UNIQUE que habilita la FK compuesta de messages (C-3).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([branchId])
  // Historial de conversaciones de un contacto.
  @@index([contactId])
  // La bandeja: conversaciones activas / derivadas de la organización.
  @@index([organizationId, status])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// Message — un mensaje dentro de una Conversation (§3).
//
// SIN updatedAt NI deletedAt: un mensaje enviado no se edita ni se borra, es
// la transcripción de algo que ya pasó con un tercero — a diferencia de
// Activity, que es una nota interna y sí se edita. Solo createdAt.
//
// senderType y senderUserId van juntos, y la base lo sostiene:
// messages_sender_user_id_consistency_check (migración 20260912130000) exige
// senderUserId cuando senderType = HUMAN y lo prohíbe para CONTACT/AGENT.
// Mismo espíritu que google_calendar_connections_channel_all_or_none_check:
// una fila HUMAN sin quién la mandó, o una CONTACT/AGENT con un usuario puesto
// por error, son estados inconsistentes que conviene que el motor rechace y no
// solo la aplicación.
// ---------------------------------------------------------------------------
model Message {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Denormalizado desde conversationId, para la FK compuesta y el aislamiento.
  organizationId String @map("organization_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  direction    MessageDirection
  senderType   MessageSenderType @map("sender_type")
  // Solo cuando senderType = HUMAN (ver el CHECK). Nullable, y por eso su FK
  // es NO ACTION.
  senderUserId String?           @map("sender_user_id") @db.Uuid

  content           String  @db.Text
  // Auditoría del turno: qué tool intentó usar el agente, con qué argumentos,
  // si puedeEjecutarTool() la permitió y qué devolvió (§6). Forma libre.
  toolCalls         Json?   @map("tool_calls")
  // Id del mensaje en el canal externo (SID de Twilio, etc.): dedup ante
  // reintentos y reentregas del webhook. Sin UNIQUE todavía: el índice que lo
  // haga cumplir nace con el webhook que lo necesite (paso 6 de §9), cuando se
  // sepa contra qué se deduplica (¿por canal? ¿por conversación?).
  externalMessageId String? @map("external_message_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  senderUser   User?        @relation("MessageSender", fields: [organizationId, senderUserId], references: [organizationId, id], onDelete: NoAction)

  // El patrón de lectura real, y el único: los mensajes de una conversación,
  // en orden. No hay listado de mensajes por organización.
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
// Módulo QR — integración de QR Reviews (docs/qr-integration.md).
//
// Portado de Plataforma-QR/supabase/migrations/*.sql (proyecto Supabase
// separado, sin negocios reales dados de alta al momento del port — no hubo
// datos que migrar, solo esquema y comportamiento). Cada modelo referencia la
// migración de origen para no perder el porqué de cada decisión (DEC-XXX).
//
// Cambio de fondo respecto del original: allá `businesses` era 1 admin : 1
// negocio, con RLS + `security definer` functions llamadas directo desde el
// frontend vía PostgREST (`anon`/`authenticated` con grants explícitos). Acá
// no hay ningún grant a `anon`/`authenticated` (ver
// 20260821140100_revoke_anon_authenticated_direct_access) — el Express
// backend es la única puerta, autoriza en código, no en RLS. Por eso
// `businesses` desaparece como tabla propia: sus atributos de suscripción
// pasan a `Organization` (billing a nivel cuenta, no por sucursal — decisión
// del plan de integración) y cada `QrCode` cuelga de una `Branch` en vez de
// tener su propio dueño.
//
// Las políticas RLS de esta sección son defensa en profundidad, igual que el
// resto del schema (ver prisma/sql/rls_policies.sql) — no la autorización
// principal.
// ═══════════════════════════════════════════════════════════════════════════

// ---------------------------------------------------------------------------
// QrCode — un QR digital, siempre reusable. id es el valor codificado en el QR
// mostrado (uuid random, nunca secuencial — DEC-011 original, no cambia).
//
// HASTA 20260904120000_remove_qr_claim_and_single_use este modelo también
// cubría el QR físico (claim, branchId nullable = "Stock sin reclamar") y el
// de un solo uso (qrType, usedAt, claimedAt). Los tres se eliminaron: Rocco
// decidió que el módulo QR solo sirve para un link digital reusable por
// sucursal, y que la fidelización automatizada se resuelve mandando el link
// directo desde el CRM, no con algo para escanear. Ver docs/qr-integration.md,
// sección "Qué se desvió", para el porqué completo. branchId/name/
// destinationUrl son NOT NULL desde esa migración porque ya no existe el
// concepto de "Stock" (nunca hubo una fila real con branchId null — no hay
// negocios reales en piloto, decisión 4 original — así que no hizo falta
// backfill).
// ---------------------------------------------------------------------------

model QrCode {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  // Etiqueta amigable para el Dashboard ("QR 1", "QR 2"...). Dashboard-only,
  // nunca parte del routing de resolución (DEC-064/065/066 original) — el
  // contador vive en Organization.nextQrDisplayNumber.
  displayNumber Int? @map("display_number")

  name           String  @db.VarChar(255)
  message        String?
  destinationUrl String  @map("destination_url")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  // onDelete: RESTRICT explícito, no el default de Prisma: regla de
  // 20260821140200 (columna referenciante NOT NULL -> RESTRICT), mismo
  // criterio que resources/service_types en 20260828160000. Antes de esta
  // migración branchId era nullable y llevaba NoAction; con NOT NULL le toca
  // RESTRICT — borrar una Branch con QRs asociados falla en vez de dejar una
  // fila sin sucursal, que ya no es una forma válida de la tabla.
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, branchId])
  @@map("qr_codes")
}

// ---------------------------------------------------------------------------
// PaymentEvent — ledger de idempotencia de webhooks de MercadoPago (D7
// original, payment_events en 0001_init.sql). organizationId nullable:
// preserva el caso de un evento que llega para una suscripción que ya no
// resuelve a ninguna cuenta.
// ---------------------------------------------------------------------------

model PaymentEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mercadopagoEventId String   @unique @map("mercadopago_event_id")
  organizationId     String?  @map("organization_id") @db.Uuid
  eventType          String   @map("event_type")
  processedAt        DateTime @default(now()) @map("processed_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("qr_payment_events")
}

// ---------------------------------------------------------------------------
// QrSubscriptionStatusChange — auditoría de cada cambio de
// qrSubscriptionStatus (D9 original, subscription_status_changes). source
// distingue si vino del webhook o de un platform admin; changedByAdmin solo
// se completa en el segundo caso (ver CHECK equivalente a
// changed_by_only_for_platform_admin, 0001_init.sql — agregar a mano igual
// que en QrCode).
// ---------------------------------------------------------------------------

model QrSubscriptionStatusChange {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String                     @map("organization_id") @db.Uuid
  previousStatus           QrSubscriptionStatus       @map("previous_status")
  newStatus                QrSubscriptionStatus       @map("new_status")
  source                   QrSubscriptionChangeSource
  changedByPlatformAdminId String?                    @map("changed_by_platform_admin_id") @db.Uuid
  reason                   String?
  createdAt                DateTime                   @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  changedByAdmin PlatformAdmin? @relation(fields: [changedByPlatformAdminId], references: [userId])

  @@map("qr_subscription_status_changes")
}

// ---------------------------------------------------------------------------
// QrBillingExemptionChange — auditoría de cada cambio de qrBillingExempt
// (DEC-057..062 original, billing_exemption_changes). A diferencia de
// QrSubscriptionStatusChange, acá siempre hay un platform admin — no existe
// un "source = webhook" para la exención (DEC-058: el webhook de
// MercadoPago nunca toca este campo).
// ---------------------------------------------------------------------------

model QrBillingExemptionChange {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  previousValue            Boolean  @map("previous_value")
  newValue                 Boolean  @map("new_value")
  changedByPlatformAdminId String   @map("changed_by_platform_admin_id") @db.Uuid
  reason                   String
  createdAt                DateTime @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id])
  changedByAdmin PlatformAdmin @relation(fields: [changedByPlatformAdminId], references: [userId])

  @@map("qr_billing_exemption_changes")
}

// ---------------------------------------------------------------------------
// PlatformAdmin — allowlist de activación manual (D8 original,
// platform_admins). Global, sin scope por Organization: es Rocco (el
// operador de la plataforma), no un rol dentro de una cuenta. Deliberadamente
// sin write path de aplicación (igual que el original) — la única forma de
// agregar una fila es acceso directo a la base. userId NO tiene FK declarada
// hacia auth.users (Prisma no modela ese schema) — mismo criterio ya usado
// para User.id, que tampoco la declara (ver prisma/sql/manual_constraints.sql):
// la igualdad con auth.users.id es un invariante de aplicación, no una FK de
// Postgres.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  subscriptionStatusChanges QrSubscriptionStatusChange[]
  billingExemptionChanges   QrBillingExemptionChange[]

  @@map("platform_admins")
}

// ═══════════════════════════════════════════════════════════════════════════
// Módulo de stock de vehículos — Fase 1: SOLO ESQUEMA.
//
// Lo que convierte a Plataforma CRM en un SaaS para automotoras: el inventario
// de unidades (Vehicle), su galería (VehiclePhoto), la auditoría de cambios de
// ficha (VehicleChangeLog) y la cotización USD/moneda local (ExchangeRate). Sin
// endpoints, sin service, sin frontend — todo eso es Fase 2; la página pública
// de publicación, Fase 3.
//
// LA DECISIÓN QUE GOBIERNA TODAS LAS COLUMNAS DE Vehicle: LA FICHA TIENE MODO
// BORRADOR. Se puede guardar incompleta y recién al querer PUBLICARLA se exige
// que ciertos campos estén completos. Por eso casi todo es nullable a nivel
// base, y "completa para publicar" es una regla de negocio del service de la
// Fase 2, NO un NOT NULL de esquema — un NOT NULL haría imposible el borrador.
// Lo único NOT NULL es lo que una fila necesita para SER un vehículo (marca,
// modelo, año, condición) más lo que el sistema asigna solo (internalCode,
// status, sucursal). No confundir "nullable en la base" con "opcional para el
// negocio": son dos preguntas distintas y acá solo se responde la primera.
//
// Aislamiento: FK compuestas por organización (C-3) en todas las relaciones
// cruzadas, índices (organization_id, ...) desde el arranque (ALTO-6), RLS de
// defensa en profundidad para cada tabla nueva (migración
// 20260907120000_vehicle_inventory_schema). La única excepción es
// ExchangeRate, y está explicada en su propio bloque.
// ═══════════════════════════════════════════════════════════════════════════

// ---------------------------------------------------------------------------
// Vehicle — una unidad del stock. Una fila por auto físico, no por modelo:
// dos Corolla 2022 iguales son dos filas con dos internalCode distintos.
//
// Las columnas van agrupadas como las secciones de la ficha (identificación,
// comercial, consignación, características, documentación, operativo,
// multimedia, publicación, contenido). El orden en la tabla no significa nada
// para Postgres; es para que el schema se lea como se lee la ficha.
//
// CAMPOS INTERNOS que NUNCA salen por una respuesta pública de la API:
// minAcceptablePriceUsd, acquisitionCostUsd, internalNotes, y toda la sección
// de consignación (datos personales del consignante). El service de la Fase 2
// tiene que hacer el `select` explícito en la página pública de la Fase 3 —
// mismo patrón que GoogleCalendarConnection.refreshToken, que Express sirve
// con un select que lo excluye. No hay ningún mecanismo de base que lo
// garantice (sería una vista o una política por columna que hoy nadie usa), así
// que la disciplina está en el código y en la revisión.
//
// Lo que la base SÍ sostiene, por CHECK en la migración (Zod los repetirá en
// el borde HTTP de la Fase 2, pero el CHECK sobrevive a un script o un seed):
//   - montos >= 0 (los seis Decimal de dinero);
//   - 0 <= consignmentCommissionPercent <= 100;
//   - mileage >= 0 y las cinco magnitudes técnicas > 0;
//   - 1900 <= year <= 2100;
//   - los ocho campos de consignación son todos NULL salvo que
//     origin = CONSIGNMENT (con NULL en origin también son NULL: un borrador
//     sin origen todavía no puede llevar datos de consignante).
// ---------------------------------------------------------------------------

model Vehicle {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // ----- Identificación --------------------------------------------------

  // Código interno correlativo por organización, asignado por el service en
  // la misma transacción que el INSERT a partir de
  // Organization.nextVehicleStockNumber (patrón de nextQrDisplayNumber). Es
  // VarChar y no Int porque lo que se muestra y se busca es el código
  // formateado ("STK-000123"); el formato lo decide la Fase 2 y la base no lo
  // impone. NOT NULL aunque la ficha sea borrador: no lo carga la persona,
  // lo pone el sistema, y una fila sin código no es localizable en el
  // salón. Único por organización SIN predicado parcial: el contador nunca
  // reusa un número, así que una unidad soft-deleted sigue ocupando el suyo
  // — es lo correcto, ese código puede estar escrito en un remito.
  internalCode String           @map("internal_code") @db.VarChar(30)
  condition    VehicleCondition
  // Nullables los tres: un 0 km no tiene patente hasta que se vende, y el
  // VIN/número de motor se completan cuando la unidad está físicamente en la
  // agencia. VarChar(30) para vin y no (17): el estándar ISO 3779 es de 17
  // caracteres, pero una unidad anterior a 1981 o importada de un mercado sin
  // ese estándar puede traer otra cosa, y rechazarla en la base sería un
  // error que nadie ve hasta que aparece ese auto. Sin @unique en ninguno de
  // los tres: dos agencias (dos organizaciones) pueden tener cargada la misma
  // unidad, y dentro de una misma organización la unicidad de patente/VIN es
  // una regla de negocio de la Fase 2 (con soft delete y unidades que
  // vuelven al stock de por medio) antes que un índice.
  licensePlate String?          @map("license_plate") @db.VarChar(20)
  vin          String?          @db.VarChar(30)
  engineNumber String?          @map("engine_number") @db.VarChar(50)
  bodyType     VehicleBodyType? @map("body_type")
  // make/model/year: lo mínimo para que una fila signifique "un auto" — sin
  // ellos ni el listado ni el borrador tienen un título que mostrar. trim es
  // la versión ("XEI", "Highline") y es texto libre por la misma razón que
  // el color: cambia con cada catálogo.
  make         String           @db.VarChar(100)
  model        String           @db.VarChar(100)
  trim         String?          @db.VarChar(100)
  year         Int

  // ----- Comercial -------------------------------------------------------

  // Los DOS precios de lista se guardan, ninguno se calcula del otro. Es una
  // decisión y no redundancia: el precio en pesos de un usado no es "USD por
  // la cotización del día" sino un número redondo que la agencia elige, y
  // que cambia cuando ELLA decide, no cuando cambia el dólar. ExchangeRate
  // existe para convertir al vuelo lo que no tiene precio local, no para
  // derivar esta columna. Decimal(14, 2) replica Opportunity.amount.
  priceListUsd          Decimal?                   @map("price_list_usd") @db.Decimal(14, 2)
  priceListLocal        Decimal?                   @map("price_list_local") @db.Decimal(14, 2)
  // INTERNOS: piso de negociación y costo de adquisición. Nunca en una
  // respuesta pública (ver la cabecera). Solo en USD: son números de gestión,
  // no de exhibición, y la agencia los piensa en dólares.
  minAcceptablePriceUsd Decimal?                   @map("min_acceptable_price_usd") @db.Decimal(14, 2)
  acquisitionCostUsd    Decimal?                   @map("acquisition_cost_usd") @db.Decimal(14, 2)
  // NOT NULL con default: una unidad recién cargada está disponible salvo
  // que se diga otra cosa, y el listado filtra por esto en todos los
  // estados, incluido el borrador.
  status                VehicleStatus              @default(AVAILABLE)
  // Visible en el LISTADO INTERNO del CRM. Distinto de publishOnWebsite (que
  // es hacia afuera) y de status: sirve para sacar de la vista diaria una
  // unidad que sigue en stock (en el taller, prestada) sin cambiarle el
  // estado ni borrarla.
  visibleInListing      Boolean                    @default(true) @map("visible_in_listing")
  origin                VehicleOrigin?
  // Fecha (sin hora) en que la unidad entró al stock. NO es createdAt: la
  // ficha se puede cargar días después de que el auto llegó, y la
  // antigüedad en stock —un número que a una automotora le importa— se
  // calcula desde acá. @db.Date como expectedCloseDate en Opportunity: un
  // día del calendario, no un instante.
  stockEnteredAt        DateTime?                  @map("stock_entered_at") @db.Date
  publicationCurrency   VehiclePublicationCurrency @default(BOTH) @map("publication_currency")
  acceptsTradeIn        Boolean                    @default(false) @map("accepts_trade_in")
  financingAvailable    Boolean                    @default(false) @map("financing_available")
  // "Consultar precio": se publica sin mostrar el número. Independiente de
  // que priceListUsd esté cargado — la agencia puede tener el precio y no
  // querer exhibirlo.
  priceOnRequest        Boolean                    @default(false) @map("price_on_request")

  // ----- Consignación ----------------------------------------------------
  // Datos del dueño que dejó la unidad en consignación. Los ocho son
  // nullables y el CHECK de la migración exige que sean NULL salvo con
  // origin = CONSIGNMENT — cambiar el origen de una unidad consignada obliga
  // al service a vaciar esta sección en la misma escritura, que es lo que
  // corresponde: los datos personales de un consignante no tienen por qué
  // sobrevivir a que la unidad deje de serlo. Son datos PERSONALES de un
  // tercero (nombre, documento, teléfono, email): entran en el criterio de
  // docs/data-classification.md y nunca salen por la API pública.
  //
  // consignorPhone VarChar(30) y consignorEmail VarChar(255) replican
  // Contact.phone / Contact.email. No se modela al consignante como Contact
  // a propósito: no es un prospecto ni un cliente, es la contraparte de un
  // contrato, y mezclarlo con el pipeline comercial contaminaría el listado
  // de contactos con gente a la que nadie le va a vender nada.
  consignorName                 String?   @map("consignor_name") @db.VarChar(255)
  consignorDocument             String?   @map("consignor_document") @db.VarChar(50)
  consignorPhone                String?   @map("consignor_phone") @db.VarChar(30)
  consignorEmail                String?   @map("consignor_email") @db.VarChar(255)
  consignmentAgreedPriceUsd     Decimal?  @map("consignment_agreed_price_usd") @db.Decimal(14, 2)
  // Porcentaje 0..100 con dos decimales, mismo tipo que Stage.probability.
  consignmentCommissionPercent  Decimal?  @map("consignment_commission_percent") @db.Decimal(5, 2)
  consignmentAgreementExpiresAt DateTime? @map("consignment_agreement_expires_at") @db.Date
  consignmentContractNumber     String?   @map("consignment_contract_number") @db.VarChar(50)

  // ----- Características -------------------------------------------------
  mileage                Int?
  transmission           VehicleTransmission?
  fuelType               VehicleFuelType?     @map("fuel_type")
  // Texto libre, no enum (ver la cabecera de los enums): "Gris Plata
  // Metalizado" es de un catálogo y de un año. La terminación sí es enum.
  exteriorColor          String?              @map("exterior_color") @db.VarChar(50)
  colorFinish            VehicleColorFinish?  @map("color_finish")
  // Cilindrada en litros con dos decimales ("1.6", "2.0", "1.25"). Decimal y
  // no Float: se muestra tal cual se cargó y un Float lo devolvería como
  // 1.6000000000000001.
  cylinderCapacityLiters Decimal?             @map("cylinder_capacity_liters") @db.Decimal(4, 2)
  drivetrain             VehicleDrivetrain?
  doors                  Int?
  upholstery             String?              @db.VarChar(100)
  powerHp                Int?                 @map("power_hp")
  seats                  Int?
  // Consumo declarado por el fabricante, km por litro. Decimal por lo mismo
  // que la cilindrada.
  declaredConsumptionKmL Decimal?             @map("declared_consumption_km_l") @db.Decimal(5, 2)
  // Códigos del multi-select de equipamiento ("ABS", "AIRBAG_LATERAL",
  // "CLIMATIZADOR"...), text[] de Postgres con default vacío. Array y no
  // tabla intermedia a propósito: el equipamiento no se filtra ni se agrega
  // por ítem en ninguna consulta prevista, solo se muestra en la ficha, y
  // una tabla VehicleEquipment sería un join que nadie usa. El catálogo de
  // códigos válidos vive en la aplicación (Fase 2), no en un enum de base:
  // agregar un ítem de equipamiento no debería requerir una migración.
  equipment              String[]             @default([])

  // ----- Documentación / garantía ----------------------------------------
  warranty                  VehicleWarranty?
  // Texto libre de la garantía cuando warranty = OTHER ("Garantía del
  // fabricante importador, 90 días"). Par "enum + detalle" y no un enum con
  // valores libres: las cuatro categorías fijas siguen siendo agrupables.
  // NULL salvo con OTHER; lo sostiene applyWarrantyRule en el service, no un
  // CHECK (ver la migración 20260911120000).
  warrantyOther             String?          @map("warranty_other") @db.VarChar(255)
  // Deuda de patentes en moneda local: es una deuda ante un fisco local, no
  // tiene sentido en USD.
  licensePlateDebtLocal     Decimal?         @map("license_plate_debt_local") @db.Decimal(14, 2)
  lastTechnicalInspectionAt DateTime?        @map("last_technical_inspection_at") @db.Date
  titleHolder               String?          @map("title_holder") @db.VarChar(255)
  // Cuatro booleanos con default false y no nullables, a diferencia del
  // resto de la sección: son casillas de la ficha, y "no marcada" es un
  // estado con significado (no se afirma), no un dato faltante. Un Boolean?
  // agregaría un tercer valor que la UI no puede mostrar.
  singleOwner               Boolean          @default(false) @map("single_owner")
  officialServiceUpToDate   Boolean          @default(false) @map("official_service_up_to_date")
  hasManualAndSpareKey      Boolean          @default(false) @map("has_manual_and_spare_key")
  titleReportRequested      Boolean          @default(false) @map("title_report_requested")

  // ----- Operativo -------------------------------------------------------
  // Sucursal NOT NULL: una unidad está en algún lugar físico desde el día
  // que entra, y el listado de una automotora con varias sucursales se
  // filtra por esto antes que por cualquier otra cosa. FK compuesta y
  // RESTRICT (columna referenciante NOT NULL, regla de 20260821140200),
  // igual que QrCode.branchId.
  branchId              String    @map("branch_id") @db.Uuid
  // Vendedor asignado. Nullable -> NO ACTION, el mismo par que
  // Company.ownerId / Contact.ownerId.
  assignedSalespersonId String?   @map("assigned_salesperson_id") @db.Uuid
  // Dónde está dentro de la sucursal ("playa 2", "salón, fila 3"). Texto
  // libre: cada agencia nombra sus lugares como quiere.
  physicalLocation      String?   @map("physical_location") @db.VarChar(255)
  // Desde cuándo se puede entregar. Distinto de stockEnteredAt: una unidad
  // puede estar en stock y no disponible (en preparación, esperando
  // documentación).
  availableSince        DateTime? @map("available_since") @db.Date

  // ----- Multimedia ------------------------------------------------------
  // Las fotos van en VehiclePhoto (tienen orden, slot y portada). Acá solo
  // los dos enlaces externos. VarChar(2048): el largo práctico de una URL.
  videoUrl   String? @map("video_url") @db.VarChar(2048)
  tour360Url String? @map("tour_360_url") @db.VarChar(2048)

  // ----- Publicación -----------------------------------------------------
  // publishOnWebsite alimenta la página pública de la Fase 3 — sin login,
  // mismo patrón que la resolución de un QR. Es la bandera que hace real la
  // regla de "completa para publicar": el service de la Fase 2 rechaza
  // ponerla en true si faltan campos, y es la ÚNICA puerta por la que una
  // unidad sale hacia afuera.
  //
  // publishOnPortals es SOLO INTENCIÓN MANUAL: registra que alguien la
  // publicó (o piensa publicarla) en un portal externo. No hay ni habrá en
  // esta fase integración con ningún portal; es una casilla, no un trigger.
  //
  // SIN índice parcial sobre publish_on_website todavía: la consulta de la
  // página pública no existe hasta la Fase 3, y un índice se agrega cuando
  // hay una consulta que lo use (criterio de service_types / outbox). El día
  // que se agregue, entra a la fila 17 del diagnóstico.
  publishOnWebsite   Boolean @default(false) @map("publish_on_website")
  publishOnPortals   Boolean @default(false) @map("publish_on_portals")
  featuredOnHomepage Boolean @default(false) @map("featured_on_homepage")

  // ----- Contenido -------------------------------------------------------
  // Sin límite de largo los dos (text). publicDescription es lo que se
  // exhibe; internalNotes es INTERNO y nunca sale por la API pública.
  publicDescription String? @map("public_description")
  internalNotes     String? @map("internal_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  // Soft delete, mismo criterio que Company/Contact/Opportunity: una unidad
  // que se saca del stock es historia (tuvo oportunidades, tuvo cambios de
  // ficha) y Opportunity.vehicleId la sigue referenciando.
  deletedAt DateTime? @map("deleted_at")

  organization        Organization @relation(fields: [organizationId], references: [id])
  branch              Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  assignedSalesperson User?        @relation("VehicleAssignedSalesperson", fields: [organizationId, assignedSalespersonId], references: [organizationId, id], onDelete: NoAction)

  photos        VehiclePhoto[]
  changeLog     VehicleChangeLog[]
  opportunities Opportunity[]

  // El UNIQUE que habilita las FKs compuestas de sus hijos (C-3): photos,
  // change log y opportunities.vehicle_id.
  @@unique([organizationId, id])
  // Ver el comentario de internalCode: sin predicado parcial a propósito.
  @@unique([organizationId, internalCode])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000. Es el séptimo
  // índice que afirma la fila 11 del diagnóstico.
  @@index([organizationId, deletedAt, createdAt])
  // Los filtros del listado, uno por índice y cada uno con organization_id
  // adelante (el listado nunca cruza organizaciones): sucursal, estado,
  // marca, condición y rango de precio. Sin índices de una sola columna
  // (branch_id, status...) como tienen las 6 entidades originales: aquellos
  // son herencia de antes de A-6, y un btree compuesto ya sirve cualquier
  // WHERE organization_id = ?. El de precio es el único que se consulta por
  // RANGO, y por eso la columna de rango va última — un btree resuelve el
  // rango en la última posición, igual que (status, channel_expiration) en
  // google_calendar_connections.
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@index([organizationId, make])
  @@index([organizationId, condition])
  @@index([organizationId, priceListUsd])
  // Lado referenciante de la FK a users: "las unidades de este vendedor".
  @@index([organizationId, assignedSalespersonId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// VehiclePhoto — una foto de la galería de una unidad.
//
// storagePath es la RUTA dentro del bucket de Supabase Storage
// ("<organization_id>/<vehicle_id>/<uuid>.jpg"), NUNCA una URL completa: la
// URL pública depende del proyecto, del bucket y de si se sirve firmada o no,
// y todo eso puede cambiar sin que cambie la foto. La URL se arma en el
// service al responder. El bucket y su política de acceso se definen en la
// Fase 2.
//
// slot es el ángulo que la ficha le pide al usuario ("frente", "perfil",
// "trasera", "interior", "tablero", "motor", "baul", "detalle") y es VarChar,
// no enum: la lista la decide la UI de la Fase 2 y puede crecer sin migración.
// NULL es una foto suelta sin ángulo asignado, y es un estado normal. Sin
// unique sobre (vehicle_id, slot): dos fotos de "detalle" son válidas.
//
// position es el orden de la galería. SIN unique sobre (vehicle_id, position)
// a propósito: reordenar con un unique obliga a pasar por valores temporales
// para no chocar en el medio del UPDATE, y el orden se reescribe entero desde
// el service (mismo criterio con el que WorkingHours se reemplaza entera).
//
// isCover: la portada del listado. A LO SUMO UNA POR UNIDAD, y eso sí lo
// sostiene la base: índice único parcial (organization_id, vehicle_id) WHERE
// is_cover = true, en la migración porque el DSL no expresa el predicado
// (fila 7 del diagnóstico). Sin él, dos escrituras concurrentes dejarían dos
// portadas y el listado mostraría una cualquiera.
//
// SIN deletedAt: borrar una foto es borrarla, no archivarla. No tiene
// historia que conservar (la tiene el vehículo) y una foto "borrada" que
// sigue ocupando espacio en Storage es un costo sin ningún uso. El DELETE
// físico es el camino previsto, igual que en WorkingHours. Sin updatedAt por
// lo mismo: una foto no se edita, se reemplaza.
// ---------------------------------------------------------------------------

model VehiclePhoto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  storagePath    String   @map("storage_path") @db.VarChar(1024)
  slot           String?  @db.VarChar(30)
  // >= 0 por CHECK en la migración.
  position       Int
  isCover        Boolean  @default(false) @map("is_cover")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  // RESTRICT (NOT NULL -> RESTRICT, regla de 20260821140200), no CASCADE:
  // vehicles usa soft delete y nunca se borra físicamente, así que la acción
  // no se dispara; y si alguien introduce un borrado físico, que falle acá
  // antes que dejar filas en Storage sin dueño en la base.
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id])

  // La única consulta que existe: "la galería de esta unidad, en orden". Un
  // solo índice sirve el lado referenciante de la FK compuesta y el ORDER BY,
  // mismo criterio que api_keys (organization_id, source_id, created_at).
  // Sin @@unique([organizationId, id]): nada referencia a una foto.
  @@index([organizationId, vehicleId, position])
  @@map("vehicle_photos")
}

// ---------------------------------------------------------------------------
// VehicleChangeLog — auditoría de cada cambio de campo en la ficha de una
// unidad: quién cambió qué, de qué valor a cuál, cuándo.
//
// UNA FILA POR CAMPO CAMBIADO, no una por edición: editar tres campos en un
// PATCH produce tres filas con el mismo changedAt. Es lo que permite
// responder "¿quién bajó el precio?" sin parsear un JSON de diff.
//
// oldValue/newValue son TEXT y nullables: el service serializa cualquier tipo
// a texto (un Decimal, un Date, un enum, un array) y NULL significa "no había
// valor" / "se vació". Guardar el tipo original no aporta nada a una
// auditoría que se lee, no se recalcula.
//
// SE LLENA EN EL SERVICE al guardar una edición (Fase 2), NO por trigger. Un
// trigger de base no sabe quién es el usuario (la app se conecta con un solo
// rol) y tendría que reconstruir el diff columna por columna en PL/pgSQL; el
// service ya tiene el antes y el después en memoria y sabe quién es. Es la
// misma división que QrSubscriptionStatusChange, que también se escribe desde
// código.
//
// APPEND-ONLY: sin updatedAt ni deletedAt, mismo criterio que IngestionEvent
// y OutboxEvent. Una fila de auditoría que se edita o se borra lógicamente
// deja de ser auditoría.
//
// changedById NOT NULL -> RESTRICT: un User referenciado por un cambio de
// ficha no se puede borrar físicamente, igual que Opportunity.ownerId y
// Activity.authorId (ver el comentario de User).
// ---------------------------------------------------------------------------

model VehicleChangeLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  changedById    String   @map("changed_by_id") @db.Uuid
  // El nombre del campo del MODELO ("priceListUsd"), no de la columna: es lo
  // que el frontend muestra y lo que el service conoce.
  fieldName      String   @map("field_name") @db.VarChar(100)
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  changedAt      DateTime @default(now()) @map("changed_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id])
  changedBy    User         @relation("VehicleChangeLogChangedBy", fields: [organizationId, changedById], references: [organizationId, id])

  // "El historial de esta unidad, más reciente primero" — la única consulta
  // prevista. Cubre además el lado referenciante de la FK a vehicles. Sin
  // índice sobre changed_by_id: no hay vista "todo lo que cambió este
  // usuario", y si aparece se agrega con ella.
  @@index([organizationId, vehicleId, changedAt])
  @@map("vehicle_change_logs")
}

// ---------------------------------------------------------------------------
// ExchangeRate — cotización de una moneda en otra para un día dado.
//
// DELIBERADAMENTE SIN organizationId. Es la ÚNICA tabla de negocio de todo el
// schema sin aislamiento por organización, y NO es un olvido: una cotización
// USD -> ARS es un dato público, igual para todas las cuentas, y guardarla una
// vez por tenant sería duplicar N veces el mismo número que un job trae de la
// misma fuente. Está en la misma categoría que Role y PlatformAdmin —tablas
// globales— y no en la de las entidades tenant-scoped. La fila 14 del
// diagnóstico (FKs compuestas) no la alcanza porque no tiene organization_id,
// y es correcto que no la alcance.
//
// RLS: habilitada, con una política de SOLO LECTURA para cualquier usuario
// autenticado — el mismo patrón que roles (roles_read_all), que es la otra
// tabla global legible. Sin política de escritura: la escribe un job del
// backend con la conexión de la app (BYPASSRLS), nunca un cliente.
//
// UNA FILA POR (base, destino, día): el @@unique de abajo. No es parcial ni
// vive en la migración porque no tiene predicado —las tres columnas son NOT
// NULL— y el DSL lo expresa completo; un unique parcial sin predicado sería
// el mismo índice escrito donde Prisma no lo ve. rateDate es @db.Date: la
// cotización es "la del 7 de septiembre", no la de un instante. fetchedAt es
// cuándo se consultó la fuente, para distinguir la cotización "de hoy"
// tomada a las 9 de la tomada a las 17 si un job vuelve a correr (el UPSERT
// sobre el unique pisa rate y fetchedAt).
//
// rate Decimal(18, 6): una cotización puede ser muy grande (USD -> ARS ya
// pasa los cuatro dígitos) o muy chica (la inversa), y seis decimales cubren
// las dos sin redondeo visible. Decimal y no Float por lo mismo que los
// precios de Vehicle. > 0 por CHECK, y base <> destino también.
//
// baseCurrency/targetCurrency VarChar(3) como Organization.preferredCurrency:
// son códigos ISO 4217, y el service convierte usando el par que la
// organización configuró en preferredCurrency/alternateCurrency.
// ---------------------------------------------------------------------------

model ExchangeRate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseCurrency   String   @map("base_currency") @db.VarChar(3)
  targetCurrency String   @map("target_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(18, 6)
  rateDate       DateTime @map("rate_date") @db.Date
  fetchedAt      DateTime @map("fetched_at")

  @@unique([baseCurrency, targetCurrency, rateDate])
  @@map("exchange_rates")
}
