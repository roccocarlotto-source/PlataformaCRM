generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum LifecycleStage {
  LEAD
  MQL
  SQL
  CUSTOMER
  CHURNED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Organization — raíz del aislamiento multi-tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  timezone  String    @default("UTC") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users         User[]
  companies     Company[]
  contacts      Contact[]
  opportunities Opportunity[]
  pipelines     Pipeline[]
  stages        Stage[]
  activities    Activity[]

  @@index([deletedAt])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Role — catálogo global de roles (ADMIN, USER). Sin scope por organización:
// para permisos granulares a futuro se agregan Permission/RolePermission
// sin tocar User ni Role.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
// User — perfil de negocio del usuario autenticado por Supabase Auth.
// id comparte valor con auth.users.id. email se sincroniza por trigger
// (ver prisma/sql/manual_constraints.sql) y nunca se escribe desde la app.
// ---------------------------------------------------------------------------

model User {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  ownedCompanies     Company[]     @relation("CompanyOwner")
  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities Activity[]    @relation("ActivityAuthor")
  assignedActivities Activity[]    @relation("ActivityAssignee")

  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Company — empresa cliente/prospecto
// ---------------------------------------------------------------------------

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  name           String    @db.VarChar(255)
  domain         String?   @db.VarChar(255)
  industry       String?   @db.VarChar(100)
  phone          String?   @db.VarChar(30)
  city           String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([domain])
  @@index([organizationId, name])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Contact — persona física. lifecycleStage reemplaza a la entidad Lead.
// ---------------------------------------------------------------------------

model Contact {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  companyId      String?        @map("company_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(30)
  jobTitle       String?        @map("job_title") @db.VarChar(100)
  lifecycleStage LifecycleStage @default(LEAD) @map("lifecycle_stage")
  source         String?        @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  opportunities Opportunity[]
  activities    Activity[]

  // Único (organization_id, email) WHERE email IS NOT NULL — índice parcial,
  // se crea manualmente en prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([companyId])
  @@index([ownerId])
  @@index([lifecycleStage])
  @@index([organizationId, lifecycleStage])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Pipeline — proceso de ventas (MVP: uno por organización)
// ---------------------------------------------------------------------------

model Pipeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  stages        Stage[]
  opportunities Opportunity[]

  // Único (organization_id) WHERE is_default = true — índice parcial,
  // se crea manualmente en prisma/sql/manual_constraints.sql
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("pipelines")
}

// ---------------------------------------------------------------------------
// Stage — etapa ordenada dentro de un Pipeline.
// organizationId denormalizado desde pipeline.organizationId (un stage nunca
// cambia de organización): evita depender de un join a Pipeline en cada
// query y en la política de RLS, igual que el resto de las entidades.
// deletedAt: soft delete, igual criterio que Company/Contact/Pipeline —
// necesario para que Opportunity (stageId obligatorio) pueda referenciar
// stages sin arriesgar una violación de integridad referencial al "borrar".
// ---------------------------------------------------------------------------

model Stage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String    @db.VarChar(100)
  order          Int
  probability    Decimal   @default(0) @db.Decimal(5, 2)
  isWon          Boolean   @default(false) @map("is_won")
  isLost         Boolean   @default(false) @map("is_lost")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  // Únicos (pipeline_id, order) y (pipeline_id, name) WHERE deleted_at IS NULL,
  // y (pipeline_id) WHERE is_won/is_lost = true — índices únicos parciales,
  // se crean manualmente en prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([pipelineId])
  @@map("stages")
}

// ---------------------------------------------------------------------------
// Opportunity — venta en curso
// ---------------------------------------------------------------------------

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  companyId         String?           @map("company_id") @db.Uuid
  contactId         String?           @map("contact_id") @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  pipelineId        String            @map("pipeline_id") @db.Uuid
  stageId           String            @map("stage_id") @db.Uuid
  title             String            @db.VarChar(255)
  amount            Decimal           @default(0) @db.Decimal(14, 2)
  currency          String            @default("USD") @db.VarChar(3)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  actualCloseDate   DateTime?         @map("actual_close_date") @db.Date
  status            OpportunityStatus @default(OPEN)
  lostReason        String?           @map("lost_reason") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id])
  stage        Stage        @relation(fields: [stageId], references: [id])

  activities Activity[]

  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL) y
  // CHECK (amount >= 0) se agregan manualmente en
  // prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stageId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Activity — interacción unificada (CALL, MEETING, EMAIL, TASK, NOTE)
// ---------------------------------------------------------------------------

model Activity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  authorId       String       @map("author_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  opportunityId  String?      @map("opportunity_id") @db.Uuid
  subject        String       @db.VarChar(255)
  body           String?
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  author       User         @relation("ActivityAuthor", fields: [authorId], references: [id])
  assignee     User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL OR
  // opportunity_id IS NOT NULL) se agrega manualmente en
  // prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([organizationId, dueDate])
  @@index([assigneeId, completedAt])
  @@map("activities")
}
