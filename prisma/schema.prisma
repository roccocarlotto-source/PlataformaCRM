generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum LifecycleStage {
  LEAD
  MQL
  SQL
  CUSTOMER
  CHURNED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// PENDING -> ACCEPTED (el invitado completó el flujo) | REVOKED (un ADMIN la
// canceló) | EXPIRED (pasó expiresAt sin aceptarse). La transición a EXPIRED
// es perezosa: no hay job programado, se recalcula en el momento en que
// importa (crear una nueva invitación para el mismo email, listar, aceptar)
// — ver invitation.repository.ts (expireDueInvitations).
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Tipo de integración de una Source. WEBHOOK: la fuente empuja un payload por
// HTTP (formulario de landing page). FILE_IMPORT: se sube un Excel/CSV.
// EXTERNAL_DB: se lee de una base de datos ajena — pospuesto a propósito, ver
// la sección 7 de docs/ingestion-architecture.md.
enum SourceType {
  WEBHOOK
  FILE_IMPORT
  EXTERNAL_DB
}

// Ciclo de vida de un IngestionEvent. PENDING (recién aterrizado, esperando al
// worker) -> PROCESSED (promovido a Contact) | FAILED (la fila no era válida;
// errorMessage dice por qué, y el resto del lote siguió) | DUPLICATE (ya había
// sido ingerido antes).
enum IngestionStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
}

// Ciclo de vida de un OutboxEvent. PENDING (esperando entrega o su próximo
// reintento) -> PROCESSED (el handler entregó) | DEAD_LETTER (agotó los
// intentos, o no hay handler para su eventType).
//
// NO HAY FAILED TRANSITORIO, a diferencia de IngestionStatus, y es una
// diferencia deliberada: allá FAILED significa "esta fila nunca va a servir"
// (el payload no era válido) y es terminal. Acá un fallo de entrega es, por
// defecto, TRANSITORIO — el destino externo puede estar caído— así que el
// evento se queda en PENDING con nextAttemptAt en el futuro. Un estado
// intermedio solo agregaría un valor más que todo consumidor tiene que
// entender, sin distinguir nada que attempts y nextAttemptAt no digan ya.
enum OutboxStatus {
  PENDING
  PROCESSED
  DEAD_LETTER
}

// Tipo de recurso agendable (docs/booking-architecture.md §3). PERSON: una
// persona que atiende (un barbero, un médico). ROOM: un espacio (una sala, una
// cancha). CLASS: una clase con cupo, donde el recurso no es ni una persona ni
// un lugar sino la clase misma.
enum ResourceType {
  PERSON
  ROOM
  CLASS
}

// Ciclo de vida de la conexión OAuth de una sucursal con Google Calendar
// (docs/booking-architecture.md §4). ACTIVE: hay un refresh token válido y
// utilizable. REVOKED: la desconectó un ADMIN desde el CRM — es un estado
// deliberado, no una falla. ERROR: Google rechazó el token (el usuario revocó el
// acceso desde su propia cuenta, o el grant caducó) — es una falla que necesita
// que alguien reconecte, y el motivo queda en lastErrorMessage.
//
// REVOKED y ERROR son el MISMO estado operativo —no se puede llamar a Google— y
// aun así son dos valores distintos a propósito: solo ERROR es una anomalía que
// alguien tiene que mirar. Colapsarlos haría imposible distinguir "esta sucursal
// decidió no usar Google" de "esta sucursal se rompió y nadie se enteró".
enum ConnectionStatus {
  ACTIVE
  REVOKED
  ERROR
}

// Día de la semana de una franja de horario de trabajo (WorkingHours).
//
// ENUM Y NO UN ENTERO 0-6, y es la decisión que evita el bug clásico de esta
// clase de modelo: no hay una convención universal sobre si 0 es domingo o
// lunes — `Date.getDay()` dice domingo, ISO-8601 y Luxon dicen lunes— así que un
// entero obliga a que TODO consumidor recuerde cuál se eligió, y el día que uno
// se equivoque el horario queda corrido un día sin ningún error visible.
//
// El orden de los valores es el ISO (lunes primero), y el mapeo desde el número
// de Luxon vive en un solo lugar: src/utils/workingHours.ts.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Ciclo de vida de un Booking (docs/booking-architecture.md §3).
//
// CONFIRMED es el único estado que OCUPA CUPO. Los otros tres son historia:
// CANCELLED (se dio de baja, el cupo se liberó), COMPLETED (la persona vino) y
// NO_SHOW (no vino). Ninguno de esos tres bloquea una reserva nueva en el mismo
// horario ni impide borrar el servicio — ver contarReservasActivas() en
// serviceType.service.ts y contarReservasSuperpuestas() en booking.repository.ts,
// que son los dos lugares donde esa distinción decide algo.
enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ---------------------------------------------------------------------------
// Organization — raíz del aislamiento multi-tenant
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(100)
  timezone  String    @default("UTC") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users         User[]
  companies     Company[]
  contacts      Contact[]
  opportunities Opportunity[]
  pipelines     Pipeline[]
  stages        Stage[]
  activities    Activity[]
  invitations   Invitation[]

  sources         Source[]
  apiKeys         ApiKey[]
  ingestionEvents IngestionEvent[]
  outboxEvents    OutboxEvent[]

  branches     Branch[]
  resources    Resource[]
  serviceTypes ServiceType[]

  googleCalendarConnections GoogleCalendarConnection[]

  workingHours WorkingHours[]
  bookings     Booking[]

  @@index([deletedAt])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Role — catálogo global de roles (ADMIN, USER). Sin scope por organización:
// para permisos granulares a futuro se agregan Permission/RolePermission
// sin tocar User ni Role.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  invitations Invitation[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
// User — perfil de negocio del usuario autenticado por Supabase Auth.
// id comparte valor con auth.users.id. email se sincroniza por trigger
// (ver prisma/sql/manual_constraints.sql) y nunca se escribe desde la app.
//
// isActive vs. deletedAt — semánticas distintas, no redundantes:
//   - isActive = false, deletedAt = null: usuario suspendido/desactivado,
//     reversible (PATCH puede volver a poner isActive = true).
//   - deletedAt != null: usuario removido de la organización — soft delete,
//     terminal, sin undelete en este bloque. Implica isActive = false.
// Un hard delete real está bloqueado de hecho por integridad referencial:
// Opportunity.ownerId y Activity.authorId son obligatorios y no declaran
// onDelete, así que Postgres ya rechaza borrar un User referenciado por
// cualquiera de los dos.
// ---------------------------------------------------------------------------

model User {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  ownedCompanies     Company[]     @relation("CompanyOwner")
  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  authoredActivities Activity[]    @relation("ActivityAuthor")
  assignedActivities Activity[]    @relation("ActivityAssignee")
  invitationsSent    Invitation[]  @relation("InvitationInvitedBy")

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Invitation — invitación pendiente de un ADMIN a un nuevo miembro de su
// organización. status es la fuente de verdad del ciclo de vida (no
// deletedAt: acá el "removido" ya tiene nombre propio — REVOKED/EXPIRED —
// y agregar deletedAt encima obligaría a explicar en qué se diferencia de
// esos dos estados, sin buena respuesta).
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(255)
  roleId         String           @map("role_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationInvitedBy", fields: [organizationId, invitedById], references: [organizationId, id])

  // Único (organization_id, email) WHERE status = 'PENDING' — índice único
  // parcial, se crea manualmente en prisma/sql/manual_constraints.sql
  // (Prisma no soporta índices únicos parciales en su DSL).
  @@index([organizationId])
  @@index([email])
  @@index([organizationId, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Company — empresa cliente/prospecto
// ---------------------------------------------------------------------------

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  name           String    @db.VarChar(255)
  domain         String?   @db.VarChar(255)
  industry       String?   @db.VarChar(100)
  phone          String?   @db.VarChar(30)
  city           String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("CompanyOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction)

  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([ownerId])
  @@index([domain])
  @@index([organizationId, name])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Contact — persona física. lifecycleStage reemplaza a la entidad Lead.
// ---------------------------------------------------------------------------

model Contact {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  companyId      String?        @map("company_id") @db.Uuid
  ownerId        String?        @map("owner_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(30)
  jobTitle       String?        @map("job_title") @db.VarChar(100)
  lifecycleStage LifecycleStage @default(LEAD) @map("lifecycle_stage")
  source         String?        @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  owner        User?        @relation("ContactOwner", fields: [organizationId, ownerId], references: [organizationId, id], onDelete: NoAction)

  opportunities   Opportunity[]
  activities      Activity[]
  ingestionEvents IngestionEvent[]
  bookings        Booking[]

  @@unique([organizationId, id])
  // Único (organization_id, email) WHERE email IS NOT NULL — índice parcial,
  // se crea manualmente en prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([companyId])
  @@index([ownerId])
  @@index([lifecycleStage])
  @@index([organizationId, lifecycleStage])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Pipeline — proceso de ventas (MVP: uno por organización)
// ---------------------------------------------------------------------------

model Pipeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  stages        Stage[]
  opportunities Opportunity[]

  // Único (organization_id) WHERE is_default = true — índice parcial,
  // se crea manualmente en prisma/sql/manual_constraints.sql
  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("pipelines")
}

// ---------------------------------------------------------------------------
// Stage — etapa ordenada dentro de un Pipeline.
// organizationId denormalizado desde pipeline.organizationId (un stage nunca
// cambia de organización): evita depender de un join a Pipeline en cada
// query y en la política de RLS, igual que el resto de las entidades.
// deletedAt: soft delete, igual criterio que Company/Contact/Pipeline —
// necesario para que Opportunity (stageId obligatorio) pueda referenciar
// stages sin arriesgar una violación de integridad referencial al "borrar".
// ---------------------------------------------------------------------------

model Stage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String    @db.VarChar(100)
  order          Int
  probability    Decimal   @default(0) @db.Decimal(5, 2)
  isWon          Boolean   @default(false) @map("is_won")
  isLost         Boolean   @default(false) @map("is_lost")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  pipeline      Pipeline      @relation(fields: [organizationId, pipelineId], references: [organizationId, id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([organizationId, id])
  // Únicos (pipeline_id, order) y (pipeline_id, name) WHERE deleted_at IS NULL,
  // y (pipeline_id) WHERE is_won/is_lost = true — índices únicos parciales,
  // se crean manualmente en prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([pipelineId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("stages")
}

// ---------------------------------------------------------------------------
// Opportunity — venta en curso
// ---------------------------------------------------------------------------

model Opportunity {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  companyId         String?           @map("company_id") @db.Uuid
  contactId         String?           @map("contact_id") @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  pipelineId        String            @map("pipeline_id") @db.Uuid
  stageId           String            @map("stage_id") @db.Uuid
  title             String            @db.VarChar(255)
  amount            Decimal           @default(0) @db.Decimal(14, 2)
  currency          String            @default("USD") @db.VarChar(3)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  actualCloseDate   DateTime?         @map("actual_close_date") @db.Date
  status            OpportunityStatus @default(OPEN)
  lostReason        String?           @map("lost_reason") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  owner        User         @relation("OpportunityOwner", fields: [organizationId, ownerId], references: [organizationId, id])
  pipeline     Pipeline     @relation(fields: [organizationId, pipelineId], references: [organizationId, id])
  stage        Stage        @relation(fields: [organizationId, stageId], references: [organizationId, id])

  activities Activity[]
  bookings   Booking[]

  @@unique([organizationId, id])
  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL) y
  // CHECK (amount >= 0) se agregan manualmente en
  // prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stageId])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, pipelineId])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Activity — interacción unificada (CALL, MEETING, EMAIL, TASK, NOTE)
// ---------------------------------------------------------------------------

model Activity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  authorId       String       @map("author_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  opportunityId  String?      @map("opportunity_id") @db.Uuid
  subject        String       @db.VarChar(255)
  body           String?
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  author       User         @relation("ActivityAuthor", fields: [organizationId, authorId], references: [organizationId, id])
  assignee     User?        @relation("ActivityAssignee", fields: [organizationId, assigneeId], references: [organizationId, id], onDelete: NoAction)
  company      Company?     @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: NoAction)
  contact      Contact?     @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: NoAction)
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: NoAction)

  // CHECK (company_id IS NOT NULL OR contact_id IS NOT NULL OR
  // opportunity_id IS NOT NULL) se agrega manualmente en
  // prisma/sql/manual_constraints.sql
  @@index([organizationId])
  @@index([authorId])
  @@index([companyId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([organizationId, dueDate])
  @@index([assigneeId, completedAt])
  // ALTO-6 — sirve al patrón de listado real de esta entidad:
  // WHERE organization_id = ? AND deleted_at IS NULL ORDER BY created_at DESC.
  // No parcial a propósito: ver la migración 20260828120000.
  @@index([organizationId, deletedAt, createdAt])
  @@map("activities")
}

// ===========================================================================
// Capa de ingesta — ver docs/ingestion-architecture.md
//
// Principio rector (sección 1): ningún dato externo se escribe directo en una
// tabla de negocio. Todo aterriza primero en IngestionEvent con su payload
// crudo intacto, y recién después de validar y mapear se promueve a Contact.
//
// Las tres tablas nacen con las FKs compuestas por organización que C-3
// impuso al resto del schema, y con los índices que sirven a su patrón de
// consulta real — el error que A-6 encontró en las 6 entidades existentes no
// se repite acá.
// ===========================================================================

// ---------------------------------------------------------------------------
// Source — una instancia concreta de integración: "landing page de precios",
// "Excel de la feria de marzo", "Postgres del cliente X".
//
// isActive vs. deletedAt — mismo criterio que en User, no son redundantes:
//   - isActive = false: integración pausada. Reversible, sigue visible en la
//     UI y su historial de eventos sigue consultable.
//   - deletedAt != null: la fuente se removió de la organización. Terminal.
// El borrado físico no es una alternativa: ingestion_events -> sources es
// RESTRICT justamente para no perder la auditoría de origen, así que una
// Source que ya ingestó algo no se puede borrar. Sin deletedAt, la lista de
// fuentes de una organización solo podría crecer.
//
// El listado por defecto se apoya en un índice PARCIAL
// (organization_id, created_at) WHERE deleted_at IS NULL — el DSL de Prisma no
// expresa índices parciales, así que se crea en la migración, igual que los 8
// únicos parciales del schema.
// ---------------------------------------------------------------------------

model Source {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String     @db.VarChar(255)
  type           SourceType
  fieldMapping   Json?      @map("field_mapping")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  apiKeys         ApiKey[]
  ingestionEvents IngestionEvent[]

  // Sin @@index([organizationId]) suelto: un btree sobre (organization_id,
  // created_at) ya sirve cualquier WHERE organization_id = ?, así que el
  // índice de una sola columna sería peso muerto. Las 6 entidades existentes
  // lo tienen porque nacieron sin el compuesto (A-6); esta no.
  @@unique([organizationId, id])
  @@map("sources")
}

// ---------------------------------------------------------------------------
// ApiKey — credencial de ingesta. Invariante de la sección 3: una API key
// resuelve a exactamente una organización, siempre. Nunca a varias, nunca a
// ninguna.
//
// keyHash: la clave se guarda hasheada, nunca en claro, y se muestra una sola
// vez al crearla. El algoritmo lo decide el ítem 3 (gestión de API keys), por
// eso la columna es text y no un VarChar dimensionado para uno en concreto.
// El @unique no es cosmético: authenticateApiKey busca por hash SIN conocer
// todavía la organización, así que la unicidad tiene que ser global.
//
// keyPrefix: los primeros caracteres, visibles, para identificar la clave en
// la UI sin exponer el resto.
//
// Sin deletedAt, mismo criterio que Invitation: revokedAt YA es el estado
// terminal y tiene nombre propio; un deletedAt encima obligaría a explicar en
// qué se diferencia de él, sin buena respuesta.
// ---------------------------------------------------------------------------

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  keyHash        String    @unique @map("key_hash")
  keyPrefix      String    @map("key_prefix") @db.VarChar(16)
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  source       Source       @relation(fields: [organizationId, sourceId], references: [organizationId, id])

  // (organization_id, source_id, created_at) cubre dos cosas con un solo
  // índice: el lado REFERENCIANTE de la FK compuesta —que Postgres no indexa
  // por su cuenta— y el listado "claves de esta fuente" ya ordenado. Sin
  // sort: Desc a propósito: un btree se recorre hacia atrás al mismo costo, y
  // el orden declarado solo importaría para un ORDER BY de direcciones mixtas.
  //
  // No hay (organization_id, created_at) aparte: el listado de claves de una
  // organización son unas pocas filas, el prefijo (organization_id) de este
  // índice ya las trae, y ordenarlas en memoria es gratis.
  @@index([organizationId, sourceId, createdAt])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// IngestionEvent — una fila por cada intento de ingesta, con el payload crudo
// intacto. Es la tabla de staging de la sección 1 y la de mayor volumen del
// schema.
//
// Sin deletedAt: es un registro de auditoría append-only. Borrarlo lógicamente
// no significa nada —o está y vale, o se purga de verdad— y una columna que
// nadie escribe pesa en millones de filas. La retención se resuelve con un
// DELETE por created_at + status, sin ninguna columna nueva; ver la sección
// 9.1 del documento de ingesta, que además explica por qué particionar esta
// tabla por fecha es incompatible con la idempotencia de acá abajo.
//
// Dos índices viven en la migración porque son PARCIALES y el DSL de Prisma no
// los expresa:
//   - UNIQUE (source_id, external_id) WHERE external_id IS NOT NULL — la
//     restricción crítica que hace idempotente la ingesta.
//   - (created_at) WHERE status = 'PENDING' — la cola del worker.
// ---------------------------------------------------------------------------

model IngestionEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  sourceId          String          @map("source_id") @db.Uuid
  externalId        String?         @map("external_id") @db.VarChar(255)
  rawPayload        Json            @map("raw_payload")
  status            IngestionStatus @default(PENDING)
  errorMessage      String?         @map("error_message")
  promotedContactId String?         @map("promoted_contact_id") @db.Uuid
  // Registro de lo que la promoción decidió sin fallar: campos donde el CRM y
  // el dato entrante diferían y ganó el CRM (§4, "nunca sobrescribir en
  // silencio"), y contactos sin email marcados para revisión manual. Es
  // información de filas PROCESSED, por eso NO vive en errorMessage — que
  // significa una sola cosa, por qué falló. Forma en src/types/promotion.ts.
  promotionNotes    Json?           @map("promotion_notes")
  // Agrupa las filas de UNA importación de archivo (ítem 5). NULL significa
  // "no vino de un lote": los eventos del webhook llegan de a uno y quedan en
  // null para siempre. Los contadores de §5 se derivan con un GROUP BY sobre
  // esta columna, no se persisten aparte — ver la migración 20260825160000.
  batchId           String?         @map("batch_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  source          Source       @relation(fields: [organizationId, sourceId], references: [organizationId, id])
  promotedContact Contact?     @relation(fields: [organizationId, promotedContactId], references: [organizationId, id], onDelete: NoAction)

  // Lado referenciante de la FK compuesta a sources, y la consulta de
  // resultado de lote de la sección 5 (cuántos entraron / se promovieron /
  // fallaron para una fuente), incluido su GROUP BY status.
  //
  // No hay índice sobre (organization_id, promoted_contact_id): Postgres solo
  // lo necesitaría para abaratar un DELETE/UPDATE del padre, y contacts usa
  // soft delete — su (organization_id, id) no cambia ni se borra nunca. Sin
  // consulta que lo use, es peso muerto en la tabla de mayor volumen.
  @@index([organizationId, sourceId, createdAt])
  // El resultado de un lote (§5): WHERE organization_id = ? AND batch_id = ?,
  // con GROUP BY status encima. Sin esto sería un seq scan sobre la tabla de
  // mayor volumen del esquema.
  @@index([organizationId, batchId])
  @@map("ingestion_events")
}

// ===========================================================================
// Motor de eventos salientes (outbox) — P1 de docs/roadmap-implementacion.md
//
// La contracara de IngestionEvent: aquella tabla es lo que el CRM RECIBE, ésta
// es lo que el CRM EMITE. El patrón es el mismo a propósito —fila de staging,
// worker con polling, reclamo con FOR UPDATE SKIP LOCKED— porque ya está
// probado en este repositorio y no había razón para inventar otro.
//
// POR QUÉ EXISTE: hoy no hay ningún mecanismo para que el CRM avise "esto
// pasó". Lo necesitan tres cosas que todavía no existen —el aviso a Resea para
// el QR de reseña, el recordatorio de WhatsApp antes de un turno, y el trigger
// "Oportunidad → Ganada" del motor de automatizaciones— y se construye una vez,
// genérico, antes de cablear cualquiera de las tres.
// ===========================================================================

// ---------------------------------------------------------------------------
// OutboxEvent — un evento de negocio que hay que entregar hacia afuera.
//
// EL PUNTO DEL PATRÓN, y lo único que no se puede aflojar: la fila se escribe
// DENTRO de la misma transacción que el cambio de negocio que la origina (ver
// emitOutboxEvent). O se guardan los dos, o no se guarda ninguno. Sin eso, un
// proceso que muere entre el commit del negocio y el envío del aviso pierde el
// aviso para siempre, y no queda rastro de que faltó.
//
// SIN deletedAt: es un registro append-only, igual que IngestionEvent. Borrarlo
// lógicamente no significa nada —o está pendiente, o ya se entregó, o murió— y
// la retención se resuelve con un DELETE físico por created_at + status (ver
// scripts/purge-outbox-events.ts).
//
// eventType es un String libre y el motor NO lo interpreta: quien emite decide
// el valor ("opportunity.won", "booking.reminder_due") y el registro de
// handlers decide quién lo atiende. El motor solo transporta.
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  payload        Json
  status         OutboxStatus @default(PENDING)
  // Cuántas veces se intentó entregar. Nace en 0 y solo sube: es lo que decide
  // cuándo se agotan los reintentos y el evento pasa a DEAD_LETTER.
  attempts       Int          @default(0)
  // NULL significa "reclamable ya" — es el estado de un evento recién emitido,
  // que nunca se intentó. Después de un fallo pasa a llevar la fecha del
  // próximo intento, calculada con backoff.
  nextAttemptAt  DateTime?    @map("next_attempt_at")
  // El último error de entrega, para poder diagnosticar un DEAD_LETTER sin
  // tener que reproducirlo.
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  // (organization_id, created_at) DESDE EL ARRANQUE, sin esperar a que alguien
  // lo audite: es la lección de ALTO-6, donde las 6 entidades de negocio
  // nacieron sin el índice de su propio listado y hubo que agregarlo tres meses
  // después. Sirve cualquier "los eventos de esta organización, más recientes
  // primero", que es como se va a mirar esta tabla desde afuera del worker.
  //
  // Sin @@index([organizationId]) suelto: un btree sobre (organization_id,
  // created_at) ya sirve cualquier WHERE organization_id = ?, así que el índice
  // de una sola columna sería peso muerto. Mismo criterio que la capa de
  // ingesta.
  //
  // El índice de la COLA —el que sirve "candidatos a reclamar"— es parcial y
  // sobre una expresión, dos formas que el DSL de Prisma no expresa: vive en la
  // migración 20260828150000.
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

// Módulo de Agenda/Booking — P2.1 de docs/roadmap-implementacion.md
//
// Primer tramo: las entidades de configuración (Branch, Resource, ServiceType).
// SIN Google Calendar y SIN Booking todavía — el resto de P2.1 viene después.
// ===========================================================================

// ---------------------------------------------------------------------------
// Branch — sucursal. Prerrequisito que el diseño daba por existente y no
// existía: docs/booking-architecture.md §3 modela Resource/ServiceType/Booking
// con organizationId + sucursalId, pero no había ninguna entidad de sucursal en
// este schema (verificado con grep sobre el archivo completo: cero
// coincidencias).
//
// SE LLAMA Branch, NO Sucursal. El schema es 100% inglés —Organization,
// Contact, Pipeline, Stage— y el `sucursalId` del documento de diseño es un
// desliz de redacción, no una decisión. La prosa de los documentos sigue
// diciendo "sucursal", igual que dice "organización" para Organization.
//
// ALCANCE ACOTADO, Y ES UNA DECISIÓN, NO UNA ETAPA INTERMEDIA: por ahora SOLO
// las entidades de Booking tienen branchId. Contact, Company, Opportunity,
// Activity, Pipeline y Stage NO lo tienen y no se preparó nada para que lo
// tengan. Sucursalizar el resto del CRM es una decisión mucho más grande —toca
// el aislamiento de todas las lecturas, no solo el modelo— y no se asume de
// antemano.
//
// SIN SUCURSAL OBLIGATORIA: el onboarding no crea ninguna. Una organización que
// no usa Booking tiene cero Branch y ese es un estado válido. No hay invariante
// de "al menos una sucursal activa" — a diferencia de "al menos un pipeline
// activo" (H-1), acá nada se rompe con cero.
//
// FK a Organization de columna simple, como todas: `organizations` tiene `id`,
// no `organization_id`, así que no existe una versión compuesta de esa
// relación. Las compuestas que impuso C-3 son las CRUZADAS entre entidades
// tenant-scoped, y las de este módulo (Resource/ServiceType -> Branch,
// ServiceType -> Resource) sí lo son.
// ---------------------------------------------------------------------------

model Branch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  // Zona horaria IANA de la sucursal ("America/Argentina/Buenos_Aires").
  // §4 del documento de diseño es explícito: cada sucursal necesita la suya y
  // NO se asume la del servidor. Se agrega ahora, antes de que Google Calendar
  // exista, para no migrar de nuevo cuando llegue — a diferencia de
  // googleCalendarId, que sí se dejó afuera: aquello es una columna que no
  // significa nada hasta que haya integración, esto es un dato del negocio que
  // ya se puede cargar y ya es correcto.
  //
  // El default "UTC" y el VarChar(50) replican Organization.timezone, para que
  // las dos tablas describan el mismo dato de la misma forma. El API igual la
  // EXIGE al crear (ver branch.controller.ts): una sucursal silenciosamente en
  // UTC produce turnos a la hora equivocada, y el default acá es una red de
  // seguridad del esquema, no la forma esperada de usarlo.
  timezone       String    @default("UTC") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  resources    Resource[]
  serviceTypes ServiceType[]

  // Singular y opcional: el @unique sobre branch_id del otro lado convierte esta
  // relación en 1-a-lo-sumo-1, y Prisma la tipa así.
  googleCalendarConnection GoogleCalendarConnection?

  bookings Booking[]

  // El UNIQUE que habilita las FKs compuestas de sus hijos (C-3).
  @@unique([organizationId, id])
  // (organization_id, created_at) desde el arranque, sin esperar a que alguien
  // lo audite: es la lección de ALTO-6, donde las 6 entidades de negocio
  // nacieron sin el índice de su propio listado.
  @@index([organizationId, createdAt])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Resource — lo que se agenda: una persona, un espacio o una clase.
//
// SIN googleCalendarId todavía. Llega recién con la integración: una columna
// nullable que nadie escribe durante meses no aporta nada y sí hay que
// explicarla en cada revisión.
// ---------------------------------------------------------------------------

model Resource {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  name           String       @db.VarChar(255)
  type           ResourceType
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])

  serviceTypes ServiceType[]
  workingHours WorkingHours[]
  bookings     Booking[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  // (organization_id, branch_id) sirve las dos consultas que de verdad
  // existen: "los recursos de esta sucursal" —el filtro más frecuente de este
  // listado— y el conteo del RESTRICT de deleteBranch. NO se agrega por ser el
  // lado referenciante de la FK: Postgres solo lo necesitaría para abaratar un
  // DELETE del padre, y branches usa soft delete, así que su
  // (organization_id, id) no cambia ni se borra nunca. Mismo criterio ya
  // aplicado en ingestion_events.
  @@index([organizationId, branchId])
  @@map("resources")
}

// ---------------------------------------------------------------------------
// ServiceType — qué se puede reservar sobre un Resource, con su duración y su
// cupo.
//
// capacity = 1 es un turno exclusivo; capacity > 1 es una clase con cupo. El
// control de capacidad al reservar es lógica de este CRM (§3 del documento), no
// algo que se delegue al proveedor de calendario — pero eso llega con Booking,
// que todavía no existe.
//
// INVARIANTE QUE EL DOCUMENTO NO MENCIONA y que el service impone: el branchId
// de un ServiceType tiene que coincidir con el branchId de su Resource. Un
// servicio "de la sucursal A" que usa un recurso de la B es un dato
// inconsistente que nadie ve hasta que alguien intenta reservar. Se valida con
// el mismo patrón que Opportunity ya usa para Stage/Pipeline (validateStageId).
//
// La FK compuesta a resources garantiza la ORGANIZACIÓN, no la sucursal: no hay
// forma de expresar "y además la misma sucursal" en una FK sin denormalizar más
// columnas. Por eso la validación vive en el service y tiene test propio.
// ---------------------------------------------------------------------------

model ServiceType {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  resourceId     String    @map("resource_id") @db.Uuid
  name           String    @db.VarChar(255)
  // Duración en minutos. El > 0 se valida en Zod y además con un CHECK en la
  // migración: un servicio de 0 minutos no es un servicio, y la defensa que
  // sobrevive a un camino de escritura futuro que no pase por el controller es
  // la de la base.
  durationMin    Int       @map("duration_min")
  // 1 = turno exclusivo, N = clase con cupo. Mismo criterio que durationMin
  // para el >= 1.
  capacity       Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])

  bookings Booking[]

  // AHORA SÍ: Booking lo referencia con una FK compuesta, así que este UNIQUE
  // dejó de ser un objeto sin uso y pasó a ser el que la habilita. Es el tercero
  // de los tres pendientes que PR #41 dejó anotados (los otros dos son el count
  // real de contarReservasActivas y el lock de deleteServiceType, los dos
  // cerrados en este mismo PR).
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, branchId])
  // Sirve el conteo del RESTRICT de deleteResource.
  @@index([organizationId, resourceId])
  @@map("service_types")
}

// ---------------------------------------------------------------------------
// GoogleCalendarConnection — la autorización OAuth de UNA sucursal contra UNA
// cuenta de Google (docs/booking-architecture.md §4, paso 2 de §9).
//
// UNA FILA POR SUCURSAL, y branch_id es UNIQUE a nivel base, no solo por
// convención del service: reconectar una sucursal ACTUALIZA su fila, nunca crea
// una segunda. Sin ese UNIQUE, dos callbacks concurrentes dejarían dos filas
// ACTIVE y nada podría decidir cuál es la buena.
//
// EL refreshToken ES NULLABLE, y eso es la mitad de la política de secretos de
// esta tabla: una conexión REVOKED no tiene token, no tiene un token vacío. Al
// desconectar se pone en NULL, así que un volcado de la base no arrastra
// credenciales de sucursales que ya se fueron. El CHECK de la migración sostiene
// la otra mitad: una fila ACTIVE SIN token es imposible.
// ---------------------------------------------------------------------------
model GoogleCalendarConnection {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  // CIFRADO EN REPOSO con AES-256-GCM (src/utils/encryption.ts) — NUNCA en
  // claro, y NUNCA en una respuesta de la API.
  //
  // ATENCIÓN AL LEER docs/booking-architecture.md §3/§4: aquello dice "mismo
  // criterio que ApiKey" y esa premisa es FALSA. ApiKey no está cifrada: está
  // HASHEADA con SHA-256 sin sal (src/utils/apiKey.ts), que es irreversible a
  // propósito porque una API key solo hay que RECONOCERLA. Un refresh token hay
  // que RECUPERARLO para poder usarlo contra Google, así que hashearlo lo
  // volvería inútil. Son dos problemas distintos con dos primitivos distintos.
  refreshToken String? @map("refresh_token")

  // El calendario sobre el que opera esta sucursal. "primary" es el calendario
  // principal de la cuenta que autorizó; el negocio puede elegir otro.
  calendarId String @default("primary") @map("calendar_id") @db.VarChar(255)

  status ConnectionStatus @default(ACTIVE)

  // Por qué esta conexión dejó de funcionar. No hay ningún mecanismo de aviso al
  // admin todavía (§4 lo pide, no existe), así que el registro en la fila ES la
  // notificación: sin esto, "status = ERROR" no dice si el usuario revocó el
  // acceso desde su cuenta de Google, si el calendario se borró, o si Google
  // estaba caído — tres cosas con tres respuestas distintas.
  //
  // VarChar(500) y no `text`: lo que se guarda acá es el `error` +
  // `error_description` de Google, no un stack. El tope obliga a truncar en el
  // service en vez de dejar que una respuesta inesperadamente larga entre entera.
  lastErrorAt      DateTime? @map("last_error_at")
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(500)

  // Cuándo se autorizó POR ÚLTIMA VEZ, distinto de createdAt: reconectar
  // actualiza la fila existente, así que createdAt sigue diciendo cuándo esta
  // sucursal conectó Google por primera vez y connectedAt cuándo vale el token
  // que hay guardado ahora.
  connectedAt DateTime @default(now()) @map("connected_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // -------------------------------------------------------------------------
  // SINCRONIZACIÓN INVERSA (paso 4 de docs/booking-architecture.md §9)
  //
  // Los cuatro son NULLABLE porque una conexión recién creada NO tiene canal: el
  // flujo OAuth del paso 2 no crea ninguno. Lo crea el worker de renovación en
  // su siguiente pasada, que trata "sin canal" y "con canal por vencer" como el
  // mismo caso. Ver googleCalendarChannelWorker.ts.
  // -------------------------------------------------------------------------

  // El id que NOSOTROS le damos al canal (un UUID). Google lo devuelve en cada
  // notificación como X-Goog-Channel-ID, y es por donde se encuentra esta fila.
  //
  // @unique: dos conexiones no pueden compartir canal, y es lo que hace que
  // buscar por channelId devuelva una fila o ninguna, nunca varias.
  channelId String? @unique @map("channel_id") @db.Uuid

  // El id OPACO que asigna Google al recurso observado. No es nuestro y no se
  // puede derivar: viene en la respuesta de events.watch y es OBLIGATORIO para
  // poder llamar a channels.stop más tarde (ese endpoint pide id + resourceId,
  // verificado contra la referencia). Sin guardarlo, un canal no se puede
  // detener nunca — solo esperar a que venza.
  channelResourceId String? @map("channel_resource_id") @db.VarChar(255)

  // Cuándo vence el canal. Google lo devuelve como timestamp Unix en
  // MILISEGUNDOS (no segundos) y el TTL por defecto es 604800 s = 7 días
  // exactos, verificado contra la referencia de events.watch.
  channelExpiration DateTime? @map("channel_expiration")

  // El token de sincronización incremental de events.list. Con él, Google
  // devuelve SOLO lo que cambió desde la última vez — incluidos los eventos
  // cancelados, que en una lista normal no aparecerían.
  //
  // NULL significa "nunca se sincronizó": la primera notificación hace una
  // sincronización completa solo para obtener un token, sin reconciliar hacia
  // atrás. Lo mismo pasa cuando Google lo invalida con un 410.
  //
  // Sin límite de longitud: Google no especifica el tamaño de estos tokens.
  syncToken String? @map("sync_token")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])

  // EL UNIQUE QUE SOSTIENE "UNA CONEXIÓN POR SUCURSAL", y es compuesto y no un
  // @unique suelto sobre branchId por un requisito de Prisma: el lado
  // definidor de una relación 1-a-1 tiene que ser único SOBRE LOS MISMOS CAMPOS
  // que usa la relación, y la de acá abajo es (organizationId, branchId).
  //
  // Garantiza exactamente lo mismo que un unique sobre branch_id solo, y no por
  // convención sino por construcción: la FK compuesta obliga a que el
  // organization_id de esta fila sea el de SU sucursal, y branches.id es la PK
  // —un solo organization_id posible por branch_id—, así que dos filas con el
  // mismo branch_id colisionan en este índice sí o sí. Un unique adicional sobre
  // branch_id sería un segundo índice para la misma garantía.
  @@unique([organizationId, branchId])
  // Sirve la pasada del worker de renovación: "conexiones ACTIVE cuyo canal
  // falta o vence pronto". Sin él, esa consulta es un scan de la tabla en cada
  // tick — barato hoy (una fila por sucursal) y no dentro de un año.
  //
  // Por (status, channel_expiration) y no al revés: el filtro por status es el
  // que descarta más filas de entrada, y channel_expiration se compara por rango
  // (< ahora + margen), que es lo que un btree resuelve en el ÚLTIMO lugar.
  // Invertido, el rango dejaría el status sin poder usarse para acotar.
  @@index([status, channelExpiration])
  // SIN (organization_id, created_at), a diferencia de branches/resources/
  // service_types, y es una decisión y no un olvido: la lección de ALTO-6 es
  // sobre el índice del LISTADO de una entidad, y acá no hay listado. Todo
  // acceso a esta tabla es por sucursal —una fila— y lo sirve el UNIQUE de acá
  // arriba, incluido el conteo del RESTRICT de deleteBranch. Mismo criterio con
  // el que service_types se quedó sin su @@unique: no se agregan objetos que
  // nadie usa.
  @@map("google_calendar_connections")
}

// ---------------------------------------------------------------------------
// WorkingHours — el horario semanal recurrente de un Resource (P2.1, paso 3).
//
// UNA FILA = UNA FRANJA de un día. "Lunes de 9 a 13 y de 16 a 20" son DOS filas,
// las dos con weekday = MONDAY. Es lo que permite el horario partido, que es la
// forma normal de trabajar de una peluquería o un consultorio, y por eso NO hay
// un @@unique([resourceId, weekday]).
//
// POR RESOURCE Y NO POR BRANCH: decisión tomada, cada recurso puede tener su
// propio horario (un barbero trabaja martes a sábado, otro lunes a viernes, en
// la misma sucursal).
//
// ALCANCE MÍNIMO A PROPÓSITO — sin excepciones, sin feriados y sin bloqueos
// puntuales. Mismo criterio con el que Branch nació sin nada opcional: se
// agregan cuando alguien los necesite. Lo que hoy NO se puede expresar y hay que
// tener presente: "el 25 de diciembre no atiendo" y "este martes me tomo la
// tarde" no tienen representación; el horario es puramente semanal.
//
// LA HORA ES LOCAL DE LA SUCURSAL, NO UTC. `weekday` + `startMinute` son
// hora de pared en la zona IANA de Branch.timezone. Convertirlas a instantes
// concretos exige una fecha y la zona, y eso vive en src/utils/workingHours.ts
// (con Luxon, por el horario de verano). Guardar UTC acá sería directamente un
// error: "los lunes a las 9" no es un instante, y en una zona con DST no
// corresponde siempre al mismo UTC.
// ---------------------------------------------------------------------------
model WorkingHours {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  resourceId     String  @map("resource_id") @db.Uuid
  weekday        Weekday

  // MINUTOS DESDE LA MEDIANOCHE LOCAL, no `time` de Postgres y no "HH:MM".
  //
  // Contra `@db.Time`: Prisma lo mapea a DateTime, así que del otro lado llega
  // un Date parado en el 1/1/1970 del que hay que extraer la hora igual — un
  // tipo más rico que no aporta nada y sí invita a operar con él como si fuera
  // un instante.
  //
  // Contra "HH:MM" en VarChar: toda la lógica de este módulo es aritmética
  // (¿entra un turno de 30 minutos?, ¿se superponen dos franjas?), y un entero
  // es la representación honesta de eso. La API sí habla "HH:MM" — la
  // conversión vive en el borde, en workingHours.controller.ts.
  //
  // Rango 0..1440. El 1440 es medianoche del día siguiente y existe para poder
  // expresar una franja que termina a las 24:00; los CHECK de la migración
  // sostienen 0 <= start < end <= 1440.
  startMinute Int @map("start_minute")
  endMinute   Int @map("end_minute")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])

  // SIN deletedAt: no es una entidad de negocio que se archive, es la
  // configuración vigente de un recurso. El endpoint la REEMPLAZA entera (ver
  // workingHours.service.ts), así que una fila vieja no significa nada — mismo
  // criterio que GoogleCalendarConnection, que tampoco lo tiene.
  //
  // (organization_id, resource_id) sirve la única consulta que existe: "el
  // horario de este recurso", que es lo que leen la disponibilidad y la
  // validación de POST /api/bookings. No hay listado por organización.
  @@index([organizationId, resourceId])
  @@map("working_hours")
}

// ---------------------------------------------------------------------------
// Booking — una reserva (docs/booking-architecture.md §3, paso 3 de §9).
//
// ES LA FUENTE DE VERDAD, y eso es una decisión de §4 y no una consecuencia:
// Google Calendar es un reflejo. Un Booking se guarda aunque Google falle o
// aunque la sucursal no tenga Google conectado — en esos casos googleEventId
// queda en NULL y la reserva vale igual.
//
// SIN deletedAt: cancelar es un `status`, no un borrado. Una reserva cancelada
// es historia que hay que conservar (el cliente canceló, eso pasó), y un soft
// delete agregaría un quinto estado que no significa nada distinto de CANCELLED.
// Mismo razonamiento que GoogleCalendarConnection.
// ---------------------------------------------------------------------------
model Booking {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  serviceTypeId  String @map("service_type_id") @db.Uuid
  resourceId     String @map("resource_id") @db.Uuid

  // NOT NULL: una reserva sin contacto no es una reserva — alguien la pidió.
  // Es la diferencia con Opportunity/Activity, donde contactId es opcional
  // porque aquellas pueden colgar de una Company.
  contactId String @map("contact_id") @db.Uuid

  // Vínculo opcional con el pipeline comercial (§3). Nullable, y por eso su FK
  // es NO ACTION y no RESTRICT — la regla de 20260821140200.
  opportunityId String? @map("opportunity_id") @db.Uuid

  // INSTANTES REALES (timestamp con zona, UTC), a diferencia de WorkingHours.
  // Acá sí corresponde: una reserva ocurre en un momento concreto. La zona de la
  // sucursal se usa para MOSTRARLA y para calcular contra el horario de trabajo,
  // no para guardarla.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  status BookingStatus @default(CONFIRMED)

  // Id del evento en Google Calendar. NULL es un estado NORMAL y esperado, no
  // un error: la sucursal puede no tener Google conectado, o la llamada puede
  // haber fallado — §4 es explícito en que eso no bloquea la reserva.
  googleEventId String? @map("google_event_id") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id])
  serviceType  ServiceType  @relation(fields: [organizationId, serviceTypeId], references: [organizationId, id])
  resource     Resource     @relation(fields: [organizationId, resourceId], references: [organizationId, id])
  contact      Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id])
  opportunity  Opportunity? @relation(fields: [organizationId, opportunityId], references: [organizationId, id], onDelete: NoAction)

  // LA CONSULTA CALIENTE DEL MÓDULO: "¿qué reservas del recurso R se superponen
  // con [inicio, fin)?". La responden la validación de capacidad de
  // POST /api/bookings y el cálculo de disponibilidad, que son los dos caminos
  // que corren en cada reserva. Sin este índice, cada una es un scan de la tabla
  // de mayor crecimiento del módulo.
  @@index([organizationId, resourceId, startsAt])
  // Sirve el conteo del RESTRICT de deleteServiceType (reservas CONFIRMED de un
  // servicio) y la capacidad por servicio.
  @@index([organizationId, serviceTypeId, startsAt])
  // "Las reservas de este contacto" — la vista de ficha de cliente.
  @@index([organizationId, contactId])
  // La agenda: "las reservas de esta organización entre dos fechas".
  @@index([organizationId, startsAt])
  @@map("bookings")
}
