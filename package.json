{
  "name": "plataforma-crm-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --test \"src/**/*.integration-test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "migrate:deploy": "tsx scripts/apply-manual-sql.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "purge:ingestion-events": "tsx scripts/purge-ingestion-events.ts",
    "purge:unconfirmed-auth-users": "tsx scripts/purge-unconfirmed-auth-users.ts",
    "audit:gate": "tsx scripts/audit-gate.ts",
    "audit:gate:frontend": "tsx scripts/audit-gate.ts frontend/npm-audit.json --workspace=frontend",
    "gen:signing-key": "tsx scripts/gen-signing-key.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "jose": "^6.2.3",
    "multer": "^2.2.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.9.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0"
  }
}
