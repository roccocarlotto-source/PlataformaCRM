# URL del proyecto de Supabase — Settings > API > Project URL.
# Pública por diseño (no es un secreto): la usa el cliente supabase-js del
# navegador para hablar con Supabase Auth.
VITE_SUPABASE_URL=

# Settings > API > Project API keys > anon public.
# Pública por diseño — segura para exponer al frontend. NUNCA la
# service_role key: esa es exclusiva del backend y jamás debe llevar el
# prefijo VITE_ (Vite expone al bundle cualquier variable con ese prefijo).
VITE_SUPABASE_ANON_KEY=

# URL base de la API propia (Express, este mismo repo). Sin barra final —
# src/config/env.ts la normaliza igual si se la dejás, pero evitá
# depender de eso. Ej: http://localhost:4000
VITE_API_URL=

# Dominio público del Cloudflare Worker que hace de gate delante de
# /qr/resolve/:qrId (docs/qr-integration.md, Fase 4): rate limiting +
# el header x-internal-proxy-secret que el backend exige. Los links de QR
# (imagen, "Copiar link", WhatsApp, email) se arman contra ESTA base, nunca
# contra VITE_API_URL — pegarle directo al backend sin pasar por el Worker
# es justo lo que /qr/resolve/:qrId rechaza a propósito.
# En producción: https://nexoraqrs.com — vale ese mismo valor real también
# en desarrollo local, porque el Worker ya apunta al backend de producción
# (no hay forma de que apunte a tu backend local).
VITE_QR_PUBLIC_BASE_URL=
