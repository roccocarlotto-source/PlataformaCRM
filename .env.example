# -----------------------------------------------------------------------------
# Base de datos (Prisma + PostgreSQL en Supabase)
# -----------------------------------------------------------------------------
# DATABASE_URL: conexión pooled vía PgBouncer (puerto 6543). La usa la app en
#   runtime. Requiere el sufijo "?pgbouncer=true" en la connection string.
# DIRECT_URL: conexión directa a Postgres (puerto 5432). La usa Prisma
#   exclusivamente para migraciones (prisma migrate).
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Supabase (proyecto)
# -----------------------------------------------------------------------------
# SUPABASE_URL: Settings > API > Project URL
# SUPABASE_ANON_KEY: Settings > API > Project API keys > anon public
#   (segura para exponer al frontend)
# SUPABASE_SERVICE_ROLE_KEY: Settings > API > Project API keys > service_role
#   (privilegiada, SOLO backend, nunca exponer al cliente ni commitear)
#
# No hace falta SUPABASE_JWT_SECRET: el backend verifica los JWT contra el
# JWKS público (SUPABASE_URL + /auth/v1/.well-known/jwks.json,
# src/lib/jwt.ts) — este proyecto de Supabase firma con claves asimétricas
# (ES256), no con el secreto compartido legacy (HS256).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Servidor Express
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# LOG_LEVEL: nivel mínimo de log de pino (fatal|error|warn|info|debug|trace).
#   Opcional — si no se define, el default es "debug" en desarrollo e "info"
#   en producción.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Cifrado de secretos en reposo
# -----------------------------------------------------------------------------
# SECRET_ENCRYPTION_KEY: clave maestra de 32 bytes en base64. De ella se derivan
#   por HKDF las subclaves de cada proposito: cifrar secretos recuperables (hoy
#   el refresh token de Google Calendar) y firmar el parametro `state` del flujo
#   OAuth.
#
#   Se genera con:  npm run gen:encryption-key
#
#   CAMBIARLA DEJA ILEGIBLE TODO LO YA CIFRADO. Rotarla de verdad exige descifrar
#   con la vieja y volver a cifrar con la nueva; hoy no hay herramienta que lo
#   haga, asi que en la practica cada sucursal tendria que reconectar Google.
SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Calendar (modulo de Agenda/Booking - docs/booking-architecture.md)
# -----------------------------------------------------------------------------
# Salen de Google Cloud Console:
#   1. Crear un proyecto (o reusar uno).
#   2. Habilitar la "Google Calendar API".
#   3. Configurar la pantalla de consentimiento de OAuth.
#   4. Crear credenciales de tipo "OAuth client ID" / "Web application".
#
# GOOGLE_REDIRECT_URI tiene que coincidir EXACTAMENTE (esquema, host, puerto y
#   path) con una de las "Authorized redirect URIs" cargadas en esa consola:
#   Google compara la cadena completa y rechaza el intercambio con
#   redirect_uri_mismatch ante cualquier diferencia, incluida una barra final.
#   Apunta al callback de ESTE backend, no al frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google-calendar/callback

# -----------------------------------------------------------------------------
# Sincronizacion inversa de Google Calendar (paso 4 del modulo de Agenda)
# -----------------------------------------------------------------------------
# GOOGLE_WEBHOOK_URL: la URL HTTPS que recibe las notificaciones push de Google
#   cuando alguien cancela o mueve un evento directamente en el calendario.
#
#   NO ALCANZA CON PONERLA ACA. Google exige que el DOMINIO este verificado y
#   registrado antes de aceptar una URL como destino de notificaciones:
#
#     1. Verificar el dominio en Google Search Console (search.google.com/search-console).
#     2. Registrarlo como dominio permitido del proyecto en la API Console:
#        Domain verification > Add domain.
#
#   Es una medida anti-abuso de Google, para que nadie pueda dirigir
#   notificaciones al dominio de otro. Sin esos dos pasos, events.watch falla y
#   la sincronizacion inversa no funciona (todo lo demas del modulo si).
#
#   Tiene que ser HTTPS con certificado valido (nada de autofirmado ni de
#   certificados de una CA no confiable), asi que en desarrollo local no funciona
#   sin un tunel publico.
#
#   Si no se configura, el worker de canales no arranca y lo avisa en el log al
#   iniciar el servidor. El resto del modulo de agenda sigue funcionando.
GOOGLE_WEBHOOK_URL=

# Las tres de abajo tienen default explicito en src/config/env.ts y NO hace falta
# definirlas; se listan para que se sepa que existen.
#
# GOOGLE_CHANNEL_WORKER_ENABLED: true|false. Default true.
# GOOGLE_CHANNEL_WORKER_POLL_MS: cada cuanto revisa canales por vencer.
#   Default 3600000 (1 hora) — tres ordenes de magnitud mas que los workers de
#   ingesta y outbox a proposito: aquellos drenan colas, este vigila canales que
#   duran 7 dias.
# GOOGLE_CHANNEL_RENEW_MARGIN_MS: cuanto antes del vencimiento se renueva.
#   Default 86400000 (24 horas). Absorbe un fin de semana de servidor caido.
# GOOGLE_CHANNEL_TTL_SECONDS: TTL que se le pide a Google. Default 604800
#   (7 dias), que es el maximo/default documentado de events.watch.
